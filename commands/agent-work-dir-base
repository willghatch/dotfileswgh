#!/bin/sh

show_help() {
    cat <<'EOF'
Usage: agent-work-dir-base [--resolve]
       agent-work-dir-base --help

Print the base path for agent work directories.
Inside a Git repository, including submodules and worktrees, find the
outermost repository's .git directory and print its agent-files/work/ path.
Outside a Git repository, print agent-files/work/ relative to the current
directory.
With --resolve, print an absolute canonical path.

Use this command to locate agent working files without placing them under
.git/modules/ or .git/worktrees/.
EOF
}

set -e

if [ "${1-}" = "--help" ]; then
    show_help
    exit 0
fi

resolve=0
if [ "$1" = "--resolve" ]; then
    resolve=1
fi

git_common_dir=$(git rev-parse --git-common-dir 2>/dev/null) || true

if [ -n "$git_common_dir" ] && ! printf '%s' "$git_common_dir" | grep -q '^fatal:'; then
    # Make absolute
    case "$git_common_dir" in
        /*) abs_dir="$git_common_dir" ;;
        *)  abs_dir="$(cd "$git_common_dir" && pwd)" ;;
    esac

    # Strip .git/modules/... or .git/worktrees/... back to the .git directory.
    # This handles submodules (whose git-common-dir is .git/modules/SUBMOD)
    # and worktrees (whose git-common-dir may be .git/worktrees/NAME or the
    # main .git itself).
    git_dir=$(printf '%s' "$abs_dir" | sed -E 's#(.*\.git)/(modules|worktrees)/.*#\1#')

    if [ "$resolve" = 1 ]; then
        git_dir=$(cd "$git_dir" && pwd)
    fi

    printf '%s/agent-files/work/\n' "$git_dir"
else
    if [ "$resolve" = 1 ]; then
        printf '%s/agent-files/work/\n' "$(pwd)"
    else
        printf 'agent-files/work/\n'
    fi
fi
