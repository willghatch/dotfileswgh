class DocsuezConfig:
    """Represents a parsed run-docsuez.json configuration"""

    def __init__(self, config_path: Path, searcher: 'DocsuezSearcher',
                 addons: Optional[List[str]] = None,
                 default_addons: Optional[List[Tuple[str, Path, str]]] = None):
        self.config_path = config_path
        self.searcher = searcher
        self.config_dir = config_path.parent
        self._raw_config = {}
        self._merged_config = None
        self.addons = addons or []
        self.default_addons = default_addons or []

    def load(self):
        """Load the configuration file"""
        with open(self.config_path, 'r') as f:
            self._raw_config = _strip_comment_keys(json.load(f))

    def _resolve_tags(self) -> Dict[str, Any]:
        """Resolve tags from all configs according to precedence rules.

        Precedence (lowest to highest):
        1. Default addon tags  (*.default.run-docsuez.json)
        2. Base config tags
        3. Default-override addon tags  (*.default-override.run-docsuez.json)
        4. User-specified addon tags  (-a flag)

        Two sources at the same priority level that define the same tag key
        are an error.  When sources at different levels define the same tag,
        the higher-priority source wins (its content replaces the lower one).
        """
        def _load_tags(path):
            with open(path, 'r') as f:
                return _strip_comment_keys(json.load(f)).get("tags", {})

        def _collect(addon_list, level_label):
            """Return {tag_name: (source_name, tag_content)}, error on duplicates."""
            tags = {}
            for addon_name, addon_path in addon_list:
                for tag_name, tag_content in _load_tags(addon_path).items():
                    if tag_name in tags:
                        prev = tags[tag_name][0]
                        print(f"Error: Tag '{tag_name}' is defined in both "
                              f"'{prev}' and '{addon_name}' ({level_label})",
                              file=sys.stderr)
                        sys.exit(1)
                    tags[tag_name] = (addon_name, tag_content)
            return tags

        # Separate default addons by kind
        regular_defaults  = [(n, p) for n, p, k in self.default_addons if k == "default"]
        override_defaults = [(n, p) for n, p, k in self.default_addons if k == "default-override"]

        # Level 1: base config
        base_tags = {
            tag: (self.config_path.name, content)
            for tag, content in self._raw_config.get("tags", {}).items()
        }

        # Level 2: regular defaults
        default_tags = _collect(regular_defaults, "default addons")

        # Level 3: default-overrides
        override_tags = _collect(override_defaults, "default-override addons")

        # Level 4: user-specified addons
        user_addon_list = []
        for addon_name in self.addons:
            addon_path = self.searcher.find_addon(addon_name)
            if not addon_path:
                print(f"Error: Addon config not found for '{addon_name}'", file=sys.stderr)
                sys.exit(1)
            user_addon_list.append((addon_name, addon_path))
        user_tags = _collect(user_addon_list, "explicit addons")

        # Build final tag map: higher priority silently replaces lower
        final = {}
        for tag, (_, content) in default_tags.items():
            final[tag] = content
        for tag, (_, content) in base_tags.items():
            final[tag] = content
        for tag, (_, content) in override_tags.items():
            final[tag] = content
        for tag, (_, content) in user_tags.items():
            final[tag] = content

        # Merge all winning tag contents into a single config dict
        result = {}
        for tag_content in final.values():
            result = self._deep_merge(result, tag_content)
        return result

    def _merge_configs(self) -> Dict[str, Any]:
        """Merge this config with any included configs and addons"""
        if self._merged_config is not None:
            return self._merged_config

        # Resolve tags first, before merging
        resolved_tags = self._resolve_tags()

        merged = {}

        # First, process includes
        includes = self._raw_config.get("include", [])
        for include_path in includes:
            included_config_path = self.searcher.find_config(include_path)
            if included_config_path:
                included = DocsuezConfig(included_config_path, self.searcher)
                included.load()
                included_merged = included._merge_configs()
                # Deep merge the included config
                merged = self._deep_merge(merged, included_merged)

        # Then overlay this config (without tags)
        config_without_tags = {k: v for k, v in self._raw_config.items() if k != "tags"}
        merged = self._deep_merge(merged, config_without_tags)

        # Merge default addons first (without tags)
        for name, addon_path, _kind in self.default_addons:
            with open(addon_path, 'r') as f:
                addon_config = _strip_comment_keys(json.load(f))
            addon_without_tags = {k: v for k, v in addon_config.items() if k != "tags"}
            merged = self._deep_merge(merged, addon_without_tags)

        # Merge user-specified addons in order (without tags)
        for addon_name in self.addons:
            addon_path = self.searcher.find_addon(addon_name)
            if not addon_path:
                print(f"Error: Addon config not found for '{addon_name}'", file=sys.stderr)
                sys.exit(1)

            with open(addon_path, 'r') as f:
                addon_config = _strip_comment_keys(json.load(f))
            addon_without_tags = {k: v for k, v in addon_config.items() if k != "tags"}
            merged = self._deep_merge(merged, addon_without_tags)

        # Finally, merge resolved tags
        merged = self._deep_merge(merged, resolved_tags)

        self._merged_config = merged
        return merged

    def _deep_merge(self, base: Dict, overlay: Dict) -> Dict:
        """Deep merge two dictionaries"""
        result = base.copy()

        for key, value in overlay.items():
            if key == "include":
                # Don't propagate include directives
                continue

            if key in ("docker-run-script", "pre-tmux-script"):
                result[key] = _merge_run_script(result.get(key), value, key)
            elif key in result and isinstance(result[key], dict) and isinstance(value, dict):
                result[key] = self._deep_merge(result[key], value)
            elif key in result and isinstance(result[key], list) and isinstance(value, list):
                result[key] = result[key] + value
            else:
                result[key] = value

        return result

    def get_image_builder(self) -> Optional[str]:
        """Get the image builder specification"""
        config = self._merge_configs()
        return config.get("image-builder")

    def get_runner_image_name(self) -> Optional[str]:
        """Get the direct image name specification from run config"""
        config = self._merge_configs()
        return config.get("image-name")

    def get_volumes(self) -> Dict[str, str]:
        """Get volume mounts (unexpanded; expanded by bash in the run script)"""
        config = self._merge_configs()
        return config.get("volumes", {})

    def get_docker_args(self) -> List[str]:
        """Get extra docker run arguments"""
        config = self._merge_configs()
        return config.get("docker-args", [])

    def get_command(self) -> Optional[List[str]]:
        """Get the command to run in the container"""
        config = self._merge_configs()
        return config.get("command")

    def get_tmux_socket_dir(self) -> Optional[str]:
        """Get the tmux socket directory"""
        config = self._merge_configs()
        return config.get("tmux-socket-dir")

    def get_docker_run_script(self) -> List[str]:
        """Get script components to run before docker, ordered by key"""
        config = self._merge_configs()
        parts = _normalize_run_script(config.get("docker-run-script"))
        return [line for key in sorted(parts) for line in parts[key]]

    def get_pre_tmux_script(self) -> List[str]:
        """Get ordered shell lines to run in the container before tmux."""
        config = self._merge_configs()
        parts = _normalize_run_script(config.get("pre-tmux-script"), "pre-tmux-script")
        return [line for key in sorted(parts) for line in parts[key]]

    def get_post_tmux_script(self) -> List[str]:
        """Get shell lines to run inside docker container after launching tmux"""
        config = self._merge_configs()
        lines = config.get("post-tmux-script", [])
        if isinstance(lines, str):
            return [lines]
        return lines


class BuildConfig:
    """Represents a parsed build-docsuez.json configuration

    {"from-docsuez": ...} and {"copy-from-docsuez": ...} entries may appear
    anywhere (and any number of times) inside the "dockerfile" spec list or
    JSON contributions expanded from a {"search-merge": ...} entry.
    Each names another docsuez build config whose resolved Docker image name
    is substituted into a FROM or COPY --from line at that position in the
    assembled Dockerfile.  The entries play the same role as "text",
    "relative-path", etc. — their position in the list controls where the
    lines appear.
    """

    def __init__(self, config_path: Path, searcher: 'DocsuezSearcher' = None):
        self.config_path = config_path
        self.config_dir = config_path.parent
        self.searcher = searcher
        self._config = {}
        self._generated_dockerfile = None
        self._expanded_dockerfile_entries = None
        self._search_merge_sources: List[Path] = []
        # Maps docsuez dependency specs to resolved image names.  Filled in by
        # the caller (via set_docsuez_image) after dependencies are resolved;
        # _generate_dockerfile substitutes these into FROM / COPY --from lines.
        self._docsuez_images: Dict[str, str] = {}

    def load(self):
        """Load the build configuration file"""
        with open(self.config_path, 'r') as f:
            self._config = _strip_comment_keys(json.load(f))
        self._expanded_dockerfile_entries = None
        self._search_merge_sources = []
        # Validate a "nix" spec up front, before anything relies on it.
        self.get_nix_spec()

    NIX_EXCLUSIVE_KEYS = ("dockerfile", "build-args", "build-context-directory", "context")

    def get_nix_spec(self) -> Optional[Dict[str, Any]]:
        """Return the validated "nix" spec, or None if this is a Dockerfile build.

        The spec has either "file" (relative to the config directory, with
        optional "attr" and string-valued "args") or "flake".  Exits with an
        error if it is malformed.
        """
        spec = self._config.get("nix")
        if spec is None:
            return None

        def fail(message):
            print(f"Error: in {self.config_path}: invalid \"nix\" spec {json.dumps(spec)}: {message}",
                  file=sys.stderr)
            sys.exit(1)

        if not isinstance(spec, dict):
            fail("must be an object")
        conflicting = [k for k in self.NIX_EXCLUSIVE_KEYS if k in self._config]
        if conflicting:
            fail(f"cannot be combined with {', '.join(conflicting)}")
        unknown = set(spec) - {"file", "attr", "args", "flake"}
        if unknown:
            fail(f"unknown key(s) {', '.join(sorted(unknown))}")
        if ("file" in spec) == ("flake" in spec):
            fail('exactly one of "file" or "flake" is required')
        if "flake" in spec:
            if not isinstance(spec["flake"], str):
                fail('"flake" must be a string')
            if "attr" in spec or "args" in spec:
                fail('"attr" and "args" only apply to "file"')
        else:
            if not isinstance(spec["file"], str):
                fail('"file" must be a string')
            if "attr" in spec and not isinstance(spec["attr"], str):
                fail('"attr" must be a string')
            args = spec.get("args", {})
            if not isinstance(args, dict) or not all(isinstance(v, str) for v in args.values()):
                fail('"args" must be an object with string values')
        return spec

    def get_nix_build_command(self) -> List[str]:
        """Return the command that builds this nix config and prints its output path.

        It must be run with the config directory as the working directory.
        """
        spec = self.get_nix_spec()
        if "flake" in spec:
            return ["nix", "build", "--no-link", "--print-out-paths", spec["flake"]]
        cmd = ["nix-build", "--no-out-link", str(self.config_dir / spec["file"])]
        if "attr" in spec:
            cmd.extend(["-A", spec["attr"]])
        for key, value in spec.get("args", {}).items():
            cmd.extend(["--argstr", key, value])
        return cmd

    def _nix_source_files(self) -> List[Path]:
        """Return the nix files under the config directory that the image is assumed to depend on."""
        sources = []
        # os.walk does not follow symlinks, so eg. a nix "result" link into
        # the store is not traversed.
        for dirpath, _dirnames, filenames in os.walk(self.config_dir):
            for name in filenames:
                if name.endswith(".nix") or name == "flake.lock":
                    sources.append(Path(dirpath) / name)
        return sources

    DOCKERFILE_ENTRY_KINDS = ("from-docsuez", "copy-from-docsuez", "text",
                              "bash-print-text", "relative-path", "search",
                              "search-merge")

    def _invalid_dockerfile_spec(self, spec, message: str, source: Path = None):
        """Report a malformed dockerfile spec and exit."""
        source = source or self.config_path
        print(f"Error: in {source}: invalid dockerfile spec {json.dumps(spec)}: {message}",
              file=sys.stderr)
        sys.exit(1)

    def _validate_dockerfile_entry(self, entry, source: Path):
        """Validate one entry object from a build config or extension."""
        if not isinstance(entry, dict):
            self._invalid_dockerfile_spec(
                entry, "each entry must be an object with one of the keys "
                + ", ".join(f'"{key}"' for key in self.DOCKERFILE_ENTRY_KINDS),
                source)
        kinds = [key for key in self.DOCKERFILE_ENTRY_KINDS if key in entry]
        if len(kinds) != 1:
            self._invalid_dockerfile_spec(
                entry, "each entry must have exactly one of the keys "
                + ", ".join(f'"{key}"' for key in self.DOCKERFILE_ENTRY_KINDS),
                source)

        kind = kinds[0]
        allowed = {
            "from-docsuez": {"from-docsuez", "as"},
            "copy-from-docsuez": {"copy-from-docsuez", "src", "dst"},
        }.get(kind, {kind})
        extra = set(entry) - allowed
        if extra:
            self._invalid_dockerfile_spec(
                entry, f'a "{kind}" entry has unknown key(s) '
                f"{', '.join(sorted(extra))}", source)

        value = entry[kind]
        if kind in ("text", "bash-print-text"):
            if not isinstance(value, str) and not (
                    isinstance(value, list) and all(isinstance(item, str) for item in value)):
                self._invalid_dockerfile_spec(
                    entry, f'"{kind}" must be a string or list of strings', source)
        elif kind in ("relative-path", "search", "search-merge", "from-docsuez"):
            if not isinstance(value, str) or not value:
                self._invalid_dockerfile_spec(
                    entry, f'"{kind}" must be a non-empty string', source)
            if kind == "from-docsuez" and "as" in entry \
                    and not isinstance(entry["as"], str):
                self._invalid_dockerfile_spec(entry, '"as" must be a string', source)
        else:
            if not isinstance(value, str) or not value:
                self._invalid_dockerfile_spec(
                    entry, '"copy-from-docsuez" must be a non-empty string', source)
            src = entry.get("src")
            if isinstance(src, str):
                src = [src]
            if not src or not isinstance(src, list) or not all(
                    isinstance(item, str) for item in src):
                self._invalid_dockerfile_spec(
                    entry, '"src" is required and must be a string or non-empty list of strings',
                    source)
            if not isinstance(entry.get("dst"), str):
                self._invalid_dockerfile_spec(
                    entry, '"dst" is required and must be a string', source)

    def _dockerfile_spec_entries(self) -> List[Dict[str, Any]]:
        """Return the dockerfile spec as a list of entries.

        A missing or empty spec means the "Dockerfile" file in the config
        directory, a string spec is a path relative to the config directory,
        and a single entry may be given without an enclosing list.  Exits with
        an error if the spec or any entry is malformed.
        """
        dockerfile_spec = self._config.get("dockerfile")
        if not dockerfile_spec:
            dockerfile_spec = "Dockerfile"
        if isinstance(dockerfile_spec, str):
            entries = [{"relative-path": dockerfile_spec}]
        elif isinstance(dockerfile_spec, dict):
            entries = [dockerfile_spec]
        elif isinstance(dockerfile_spec, list):
            entries = dockerfile_spec
        else:
            self._invalid_dockerfile_spec(dockerfile_spec,
                                          "must be a string, an entry object, or a list of entry objects")
        for entry in entries:
            self._validate_dockerfile_entry(entry, self.config_path)
        return entries

    def _record_search_merge_source(self, path: Path):
        """Record a file or directory that affects search-merge expansion."""
        if path not in self._search_merge_sources:
            self._search_merge_sources.append(path)

    def _record_search_merge_parent(self, candidate: Path, search_root: Path):
        """Track the nearest existing parent so additions and removals make builds stale."""
        parent = candidate.parent
        while parent != search_root and not parent.exists():
            parent = parent.parent
        if parent.exists():
            self._record_search_merge_source(parent)

    def _search_merge_files(self, merge_path: str, source: Path) -> List[Tuple[int, Path]]:
        """Return matching JSON files as (search-root index, path)."""
        if not self.searcher:
            self._invalid_dockerfile_spec(
                {"search-merge": merge_path},
                'cannot use "search-merge" without a searcher instance', source)
        merge_path_obj = Path(merge_path)
        if merge_path_obj.is_absolute() or ".." in merge_path_obj.parts:
            self._invalid_dockerfile_spec(
                {"search-merge": merge_path},
                '"search-merge" must be relative and remain within each search root',
                source)

        matches = []
        for root_index, search_root in enumerate(self.searcher.search_paths):
            candidate = search_root / merge_path_obj
            if search_root.exists():
                self._record_search_merge_parent(candidate, search_root)
            if not candidate.exists():
                continue
            if candidate.is_symlink():
                self._invalid_dockerfile_spec(
                    {"search-merge": merge_path},
                    f"matched path {candidate} must be a regular JSON file or directory",
                    source)
            if candidate.is_file():
                self._record_search_merge_source(candidate)
                matches.append((root_index, candidate))
                continue
            if not candidate.is_dir():
                self._invalid_dockerfile_spec(
                    {"search-merge": merge_path},
                    f"matched path {candidate} must be a regular JSON file or directory",
                    source)

            self._record_search_merge_source(candidate)
            for child in sorted(candidate.iterdir(), key=lambda path: path.name):
                if child.is_symlink() or not child.is_file() or child.suffix != ".json":
                    self._invalid_dockerfile_spec(
                        {"search-merge": merge_path},
                        f"directory {candidate} contains non-JSON file {child}", source)
                self._record_search_merge_source(child)
                matches.append((root_index, child))
        return matches

    def _numeric_merge_position(self, key, source: Path) -> float:
        """Parse a finite numeric search-merge position."""
        try:
            position = float(key)
        except (TypeError, ValueError):
            self._invalid_dockerfile_spec(
                {key: "..."}, f"search-merge position {key!r} is not a number", source)
        if not math.isfinite(position):
            self._invalid_dockerfile_spec(
                {key: "..."}, f"search-merge position {key!r} is not finite", source)
        return position

    def _contribution_entries(self, path: Path) -> List[Tuple[float, int, Dict[str, Any]]]:
        """Load and normalize one JSON contribution to (position, list index, entry)."""
        try:
            with open(path, 'r') as f:
                contribution = _strip_comment_keys(json.load(f))
        except (OSError, json.JSONDecodeError) as error:
            print(f"Error: invalid search-merge contribution {path}: {error}", file=sys.stderr)
            sys.exit(1)

        positioned = []

        def add(position, value):
            entries = value if isinstance(value, list) else [value]
            for list_index, entry in enumerate(entries):
                self._validate_dockerfile_entry(entry, path)
                positioned.append((position, list_index, entry))

        if isinstance(contribution, list):
            add(50, contribution)
        elif isinstance(contribution, dict) and any(
                kind in contribution for kind in self.DOCKERFILE_ENTRY_KINDS):
            add(50, contribution)
        elif isinstance(contribution, dict) and contribution:
            for key, value in contribution.items():
                position = self._numeric_merge_position(key, path)
                if not isinstance(value, (dict, list)):
                    self._invalid_dockerfile_spec(
                        contribution,
                        f"value at search-merge position {key!r} must be an entry or list",
                        path)
                add(position, value)
        else:
            self._invalid_dockerfile_spec(
                contribution,
                "a search-merge contribution must be an entry, a list of entries, "
                "or a non-empty numeric-keyed object",
                path)
        return positioned

    def _expand_search_merge(self, merge_path: str, source: Path,
                             stack: List[Path]) -> List[Tuple[Dict[str, Any], Path]]:
        """Expand one search-merge entry, retaining each JSON file as its origin."""
        contributions = []
        for root_index, path in self._search_merge_files(merge_path, source):
            resolved = path.resolve()
            if resolved in stack:
                cycle = stack[stack.index(resolved):] + [resolved]
                print("Error: search-merge cycle: "
                      + " -> ".join(str(item) for item in cycle), file=sys.stderr)
                sys.exit(1)
            for position, list_index, entry in self._contribution_entries(path):
                contributions.append(
                    (position, root_index, path.name, list_index, entry, path, resolved))

        contributions.sort(key=lambda item: item[:4])
        expanded = []
        for _position, _root_index, _name, _list_index, entry, path, resolved in contributions:
            if "search-merge" in entry:
                expanded.extend(self._expand_search_merge(
                    entry["search-merge"], path, stack + [resolved]))
            else:
                expanded.append((entry, path.parent))
        return expanded

    def _get_expanded_dockerfile_entries(self) -> List[Tuple[Dict[str, Any], Path]]:
        """Return entries with search-merge points recursively expanded."""
        if self._expanded_dockerfile_entries is None:
            self._search_merge_sources = []
            expanded = []
            for entry in self._dockerfile_spec_entries():
                if "search-merge" in entry:
                    expanded.extend(self._expand_search_merge(
                        entry["search-merge"], self.config_path, []))
                else:
                    expanded.append((entry, self.config_dir))
            self._expanded_dockerfile_entries = expanded
        return self._expanded_dockerfile_entries

    def _parse_docsuez_entry(self, spec) -> Optional[Tuple[str, str]]:
        """Validate a dockerfile spec entry that references a docsuez image.

        Returns (kind, dependency_spec), where kind is "from-docsuez" or
        "copy-from-docsuez", or None if the entry is some other kind.
        Exits with an error for malformed entries.
        """
        if not isinstance(spec, dict):
            return None
        if "from-docsuez" in spec:
            kind, allowed = "from-docsuez", {"from-docsuez", "as"}
        elif "copy-from-docsuez" in spec:
            kind, allowed = "copy-from-docsuez", {"copy-from-docsuez", "src", "dst"}
        else:
            return None

        def fail(message):
            print(f"Error: in {self.config_path}: invalid '{kind}' entry {spec}: {message}",
                  file=sys.stderr)
            sys.exit(1)

        extra = set(spec) - allowed
        if extra:
            fail(f"unknown key(s) {', '.join(sorted(extra))}")
        if not isinstance(spec[kind], str):
            fail(f"'{kind}' must be a string")
        if kind == "from-docsuez":
            if "as" in spec and not isinstance(spec["as"], str):
                fail("'as' must be a string")
        else:
            src = spec.get("src")
            if isinstance(src, str):
                src = [src]
            if not src or not isinstance(src, list) or not all(isinstance(x, str) for x in src):
                fail("'src' is required and must be a string or a non-empty list of strings")
            if not isinstance(spec.get("dst"), str):
                fail("'dst' is required and must be a string")
        return kind, spec[kind]

    def get_docsuez_dependencies(self) -> List[str]:
        """Return the docsuez image specs this build references, in order, without repeats.

        These are the names in {"from-docsuez": ...} and
        {"copy-from-docsuez": ...} entries of the expanded Dockerfile spec.
        Nix builds have none; nix expressions compose in nix.
        """
        if self.get_nix_spec() is not None:
            return []
        deps = []
        for entry, _origin in self._get_expanded_dockerfile_entries():
            parsed = self._parse_docsuez_entry(entry)
            if parsed is not None and parsed[1] not in deps:
                deps.append(parsed[1])
        return deps

    def set_docsuez_image(self, dep_spec: str, image_name: str):
        """Record the resolved Docker image name for a docsuez dependency spec.

        Must be called for every spec from get_docsuez_dependencies() before
        get_dockerfile() / _generate_dockerfile().
        """
        self._docsuez_images[dep_spec] = image_name

    def _resolve_search_path(self, search_file: str) -> Path:
        """Search for a file in the docsuez search paths"""
        if not self.searcher:
            raise ValueError("Cannot use 'search' without a searcher instance")

        for search_path in self.searcher.search_paths:
            candidate = search_path / search_file
            if candidate.exists():
                return candidate

        raise FileNotFoundError(f"Could not find '{search_file}' in any search path: {self.searcher.search_paths}")

    def _generate_dockerfile(self) -> Tuple[str, Path]:
        """Generate dockerfile content and return (content, temp_path).

        When the dockerfile spec references docsuez images, the caller must
        first call set_docsuez_image() for each of them.  Each
        {"from-docsuez": ...} or {"copy-from-docsuez": ...} entry is then
        replaced with the corresponding FROM or COPY --from line at that
        position in the Dockerfile.
        """
        import tempfile

        content_parts = []

        for spec, origin in self._get_expanded_dockerfile_entries():
            docsuez_entry = self._parse_docsuez_entry(spec)
            if docsuez_entry is not None:
                kind, dep_spec = docsuez_entry
                if dep_spec not in self._docsuez_images:
                    raise ValueError(
                        f"set_docsuez_image() must be called for '{dep_spec}' "
                        "before _generate_dockerfile()"
                    )
                image = self._docsuez_images[dep_spec]
                if kind == "from-docsuez":
                    line = f"FROM {image}"
                    if "as" in spec:
                        line += f" AS {spec['as']}"
                else:
                    srcs = spec["src"] if isinstance(spec["src"], list) else [spec["src"]]
                    line = f"COPY --from={image} {' '.join(srcs)} {spec['dst']}"
                content_parts.append(line)
            elif isinstance(spec, dict) and "text" in spec:
                # Literal text - handle string or list of strings
                dockerfile_text = spec["text"]
                if isinstance(dockerfile_text, list):
                    dockerfile_text = "\n".join(dockerfile_text)
                content_parts.append(dockerfile_text)
            elif isinstance(spec, dict) and "bash-print-text" in spec:
                # Bash program that outputs dockerfile text
                bash_program = spec["bash-print-text"]
                # Handle string or list of strings
                if isinstance(bash_program, list):
                    bash_program = "\n".join(bash_program)
                # Run bash program and capture output
                result = subprocess.run(
                    ["bash", "-c", bash_program],
                    capture_output=True,
                    text=True,
                    check=True,
                    cwd=origin
                )
                content_parts.append(result.stdout)
            elif isinstance(spec, dict) and "relative-path" in spec:
                # File path relative to the build config or contribution.
                file_path = origin / spec["relative-path"]
                with open(file_path, 'r') as f:
                    content_parts.append(f.read())
            else:
                # Search for file in search paths
                file_path = self._resolve_search_path(spec["search"])
                with open(file_path, 'r') as f:
                    content_parts.append(f.read())

        content = "\n".join(content_parts)

        # Write to temporary file
        fd, temp_path = tempfile.mkstemp(suffix=".Dockerfile", prefix="docsuez-")
        with os.fdopen(fd, 'w') as f:
            f.write(content)

        self._generated_dockerfile = Path(temp_path)
        return content, Path(temp_path)

    def get_dockerfile(self) -> str:
        """Get the Dockerfile path.

        When the dockerfile spec references docsuez images,
        set_docsuez_image() must be called for each of them first.
        """
        if self._generated_dockerfile:
            return str(self._generated_dockerfile)

        dockerfile_spec = self._config.get("dockerfile") or "Dockerfile"

        # Simple string path
        if isinstance(dockerfile_spec, str):
            return str(self.config_dir / dockerfile_spec)

        _, temp_path = self._generate_dockerfile()
        return str(temp_path)

    def get_dockerfile_sources(self) -> List[Path]:
        """Get all source files that contribute to the dockerfile.

        {"from-docsuez": ...} and {"copy-from-docsuez": ...} entries have no
        local source files of their own; each dependency is tracked via its
        own BuildConfig.
        """
        entries = self._get_expanded_dockerfile_entries()
        sources = list(self._search_merge_sources)
        for spec, origin in entries:
            if "relative-path" in spec:
                sources.append(origin / spec["relative-path"])
            elif "search" in spec:
                try:
                    sources.append(self._resolve_search_path(spec["search"]))
                except FileNotFoundError:
                    # Skip if not found during source collection
                    pass
            # Skip literal text and docsuez image entries
        return sources

    def get_newest_source_mtime(self) -> float:
        """Get the newest modification time among all build sources (dockerfile + config)

        For nix builds, the sources are the config plus every *.nix and
        flake.lock file under the config directory.  Changes to nix inputs
        outside it are not detected.
        """
        if self.get_nix_spec() is not None:
            sources = self._nix_source_files()
        else:
            sources = self.get_dockerfile_sources()

        # Also include the build config file itself
        sources.append(self.config_path)

        if not sources:
            return 0.0

        mtimes = [src.stat().st_mtime for src in sources if src.exists()]
        return max(mtimes) if mtimes else 0.0

    def get_build_context_directory(self) -> str:
        """Get the build context path"""
        context = self._config.get("build-context-directory") or self._config.get("context", ".")
        return str(self.config_dir / context)

    def get_builder_image_name(self) -> str:
        """Get the image name to build"""
        # Get base image name from config or auto-generate it
        if "image-name-postfix" in self._config:
            base_name = self._config["image-name-postfix"]
        else:
            base_name = f"docsuez_{self.config_dir.name}:latest"

        # Prepend username unless DOCSUEZ_NO_USER_NAME_PREPEND is set
        if not os.environ.get("DOCSUEZ_NO_USER_NAME_PREPEND"):
            username = os.environ.get("USER", "unknown")
            base_name = f"{username}_{base_name}"

        return base_name

    def get_build_args(self) -> Dict[str, str]:
        """Get build arguments"""
        return self._config.get("build-args", {})

    def cleanup(self):
        """Clean up temporary files"""
        if self._generated_dockerfile and self._generated_dockerfile.exists():
            self._generated_dockerfile.unlink()


class DocsuezSearcher:
    """Searches for docsuez configuration files"""

    def __init__(self):
        # Define search paths from DOCSUEZ_PATH or XDG directories
        self.search_paths = []

        # Check for DOCSUEZ_PATH environment variable first
        docsuez_path = os.environ.get("DOCSUEZ_PATH")
        if docsuez_path:
            # Split by colon and add each path
            for path_str in docsuez_path.split(":"):
                if path_str:  # Skip empty strings
                    self.search_paths.append(Path(path_str))
        else:
            # Fall back to XDG directories
            home = Path.home()

            # Add XDG_CONFIG_HOME/docsuez (default: ~/.config/docsuez)
            xdg_config_home = os.environ.get("XDG_CONFIG_HOME", str(home / ".config"))
            self.search_paths.append(Path(xdg_config_home) / "docsuez")

            # Add PATH/docsuez for each path in XDG_CONFIG_DIRS
            xdg_config_dirs = os.environ.get("XDG_CONFIG_DIRS", "/etc/xdg")
            for config_dir in xdg_config_dirs.split(":"):
                if config_dir:  # Skip empty strings
                    self.search_paths.append(Path(config_dir) / "docsuez")

        # De-duplicate search paths while preserving order
        seen = set()
        deduped_paths = []
        for path in self.search_paths:
            # Resolve to absolute path for comparison
            resolved = path.resolve()
            if resolved not in seen:
                seen.add(resolved)
                deduped_paths.append(path)
        self.search_paths = deduped_paths

    def find_all_configs(self) -> List[Path]:
        """Find all run-docsuez.json files in search paths"""
        configs = []

        for search_path in self.search_paths:
            if not search_path.exists():
                continue

            # Recursively find all run-docsuez.json files
            for config_file in search_path.rglob("run-docsuez.json"):
                configs.append(config_file)

        return configs

    def find_config(self, name: str) -> Optional[Path]:
        """Find a specific run-docsuez.json by directory name or path"""
        # First check if it's a direct path
        direct_path = Path(name)
        if direct_path.exists() and direct_path.is_file():
            return direct_path

        # Check if it's a directory with a run-docsuez.json
        if direct_path.exists() and direct_path.is_dir():
            config_file = direct_path / "run-docsuez.json"
            if config_file.exists():
                return config_file

        # Search for directory with matching name
        for search_path in self.search_paths:
            if not search_path.exists():
                continue

            # Look for a directory with this name
            target_dir = search_path / name
            if target_dir.exists() and target_dir.is_dir():
                config_file = target_dir / "run-docsuez.json"
                if config_file.exists():
                    return config_file

        return None

    def find_build_config(self, image_spec: str) -> Optional[Path]:
        """Find a build-docsuez.json for the given image spec"""
        # Similar to find_config, but looking for build-docsuez.json
        direct_path = Path(image_spec)
        if direct_path.exists() and direct_path.is_file():
            return direct_path

        if direct_path.exists() and direct_path.is_dir():
            build_file = direct_path / "build-docsuez.json"
            if build_file.exists():
                return build_file

        for search_path in self.search_paths:
            if not search_path.exists():
                continue

            target_dir = search_path / image_spec
            if target_dir.exists() and target_dir.is_dir():
                build_file = target_dir / "build-docsuez.json"
                if build_file.exists():
                    return build_file

        return None

    def _all_default_files(self) -> Dict[str, Path]:
        """Return {name: path} for all *.default.run-docsuez.json files.

        Defaults have the lowest tag priority, so they can be shadowed by the
        base config, overrides, or explicit addons.  All defaults are therefore
        available as explicit addons (-a NAME) so callers can reinstate one at
        higher priority.
        """
        defaults: Dict[str, Path] = {}
        for search_path in self.search_paths:
            if not search_path.exists():
                continue
            for f in search_path.rglob("*.default.run-docsuez.json"):
                name = f.name.replace(".default.run-docsuez.json", "")
                if name not in defaults:
                    defaults[name] = f
        return defaults

    def find_addon(self, addon_name: str) -> Optional[Path]:
        """Find an addon configuration file (NAME.run-docsuez.json).

        Also finds any *.default.run-docsuez.json file so it can be explicitly
        requested with -a (where it gets user-addon priority, overriding the
        default, base-config, and default-override layers).
        """
        addon_filename = f"{addon_name}.run-docsuez.json"

        # Check if it's a direct path
        direct_path = Path(addon_name)
        if direct_path.exists() and direct_path.is_file():
            return direct_path

        # Search in all search paths
        for search_path in self.search_paths:
            if not search_path.exists():
                continue

            # Look for NAME.run-docsuez.json directly in search path
            addon_file = search_path / addon_filename
            if addon_file.exists():
                return addon_file

            # Also check subdirectories
            for addon_file in search_path.rglob(addon_filename):
                return addon_file

        # Fall back to any default file
        return self._all_default_files().get(addon_name)

    def find_default_addons(self) -> List[Tuple[str, Path, str]]:
        """Find all default addon files.

        Returns a list of (name, path, kind) tuples where kind is
        'default' or 'default-override'.  Tag conflicts between the two
        kinds are resolved by priority in DocsuezConfig._resolve_tags:
        default-overrides beat regular defaults.
        """
        default_addons = []

        for search_path in self.search_paths:
            if not search_path.exists():
                continue

            for addon_file in search_path.rglob("*.default-override.run-docsuez.json"):
                name = addon_file.name.replace(".default-override.run-docsuez.json", "")
                default_addons.append((name, addon_file, "default-override"))

        for search_path in self.search_paths:
            if not search_path.exists():
                continue

            for addon_file in search_path.rglob("*.default.run-docsuez.json"):
                name = addon_file.name.replace(".default.run-docsuez.json", "")
                default_addons.append((name, addon_file, "default"))

        return default_addons

    def get_config_names(self) -> List[str]:
        """Get list of available config names that can be used with 'docsuez run'"""
        config_names = set()

        for search_path in self.search_paths:
            if not search_path.exists():
                continue

            # Find all run-docsuez.json files
            for config_file in search_path.rglob("run-docsuez.json"):
                # Use the parent directory name as the config name
                config_names.add(config_file.parent.name)

        return sorted(config_names)

    def get_addon_names(self) -> List[str]:
        """Get list of available addon names that can be used with -a flag.

        Includes all *.default.run-docsuez.json files, since any of them can be
        re-added explicitly with -a to override what the base config or a
        default-override would otherwise select.
        """
        addon_names = set()

        for search_path in self.search_paths:
            if not search_path.exists():
                continue

            for addon_file in search_path.rglob("*.run-docsuez.json"):
                if addon_file.name == "run-docsuez.json":
                    continue

                name = addon_file.name.replace(".run-docsuez.json", "")
                # Exclude .default and .default-override addons (auto-loaded)
                if not name.endswith(".default") and not name.endswith(".default-override"):
                    addon_names.add(name)

        # All defaults can be used explicitly to reinstate at higher priority
        addon_names.update(self._all_default_files().keys())

        return sorted(addon_names)

    def get_build_names(self) -> List[str]:
        """Get list of available build names that can be used with 'docsuez build'"""
        build_names = set()

        for search_path in self.search_paths:
            if not search_path.exists():
                continue

            # Find all build-docsuez.json files
            for build_file in search_path.rglob("build-docsuez.json"):
                # Use the parent directory name as the build name
                build_names.add(build_file.parent.name)

        return sorted(build_names)


class BuildCache:
    """Records when docsuez built or loaded each image.

    Stored as JSON in $XDG_CACHE_HOME/docsuez/build-cache.json, keyed by full
    docker image name.  Each entry has the docker "image-id" it describes, the
    "built-at" time (unix seconds), and for nix-backed images the
    "nix-out-path" that was loaded and the "checked-at" time the nix output
    was last confirmed unchanged.  An entry only applies while docker still
    has that image id under that name.
    """

    def __init__(self):
        cache_home = os.environ.get("XDG_CACHE_HOME") or str(Path.home() / ".cache")
        self.path = Path(cache_home) / "docsuez" / "build-cache.json"
        self._warned = False

    def _warn(self, message: str):
        """Print a cache warning once per invocation."""
        if not self._warned:
            print(f"Warning: {message}", file=sys.stderr)
            self._warned = True

    def _read(self) -> Dict[str, Any]:
        """Return the whole cache; a missing, unreadable, or corrupt file reads as empty."""
        try:
            text = self.path.read_text()
        except FileNotFoundError:
            return {}
        except OSError as e:
            self._warn(f"cannot read build cache {self.path}: {e}")
            return {}
        try:
            data = json.loads(text)
        except ValueError:
            data = None
        if not isinstance(data, dict):
            self._warn(f"ignoring corrupt build cache {self.path}")
            return {}
        return data

    def get_entry(self, image_name: str, image_id: Optional[str]) -> Optional[Dict[str, Any]]:
        """Return the entry for image_name if it describes image_id, else None."""
        if not image_id:
            return None
        entry = self._read().get(image_name)
        if isinstance(entry, dict) and entry.get("image-id") == image_id:
            return entry
        return None

    def update(self, image_name: str, entry: Dict[str, Any]):
        """Replace the entry for image_name."""
        self.path.parent.mkdir(parents=True, exist_ok=True)
        # Lock a separate file: the cache file itself is replaced by rename,
        # so a lock on it would not exclude a concurrent writer.
        with open(self.path.with_name(self.path.name + ".lock"), "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            data = self._read()
            data[image_name] = entry
            fd, tmp_path = tempfile.mkstemp(dir=self.path.parent, prefix=".build-cache.",
                                            suffix=".json")
            with os.fdopen(fd, "w") as f:
                json.dump(data, f, indent=2, sort_keys=True)
                f.write("\n")
            os.replace(tmp_path, self.path)


# Docker creation times before this are treated as unknown.  Nix dockerTools
# images are created at unix time 0 for reproducibility.
PLAUSIBLE_IMAGE_CREATION_TIME = 315532800.0  # 1980-01-01T00:00:00Z


class Docsuez:
    def __init__(self):
        self.searcher = DocsuezSearcher()
        self.build_cache = BuildCache()
        self.tsuez_cmd = "tsuez"  # Find tsuez on PATH
        # Docsuez dependency images already resolved in this invocation, keyed
        # by resolved build config path, so each is checked/built only once.
        self._resolved_dependency_images: Dict[Path, str] = {}
        # Build configs currently being resolved, for cycle detection.
        self._resolving_build_configs: List[Path] = []

    def cmd_list_configurations(self, args):
        """List available configuration names for use with 'docsuez run'"""
        config_names = self.searcher.get_config_names()
        for name in config_names:
            print(name)

    def cmd_list_addons(self, args):
        """List available addon names for use with -a flag"""
        addon_names = self.searcher.get_addon_names()
        for name in addon_names:
            print(name)

    def cmd_list_builds(self, args):
        """List available build names for use with 'docsuez build'"""
        build_names = self.searcher.get_build_names()
        for name in build_names:
            print(name)

    def cmd_build(self, args):
        """Build a docker image from a build-docsuez.json spec"""
        build_config_path = self.searcher.find_build_config(args.image_spec)

        if not build_config_path:
            print(f"Build config not found for '{args.image_spec}'", file=sys.stderr)
            sys.exit(1)

        build_config = BuildConfig(build_config_path, self.searcher)
        build_config.load()

        # Resolve and build any docsuez image dependencies before assembling
        # the Dockerfile or running the build.  Use "detect" build mode by
        # default (the build subcommand always builds the top-level image, but
        # dependencies are only rebuilt if out of date).  A dry run only
        # resolves dependency image names, without touching docker.
        dry_show = getattr(args, 'dry_show', False)
        self._resolve_top_level_dependencies(
            build_config, no_cache=getattr(args, 'no_cache', False), dry_run=dry_show)

        # If dry-show mode, print the assembled dockerfile (or the nix build
        # commands) and exit
        if dry_show and build_config.get_nix_spec() is not None:
            image_name = build_config.get_builder_image_name()
            print(f"# in {build_config.config_dir}:")
            print(shlex.join(build_config.get_nix_build_command()))
            print("# then, unless the build cache shows OUT_PATH already loaded as "
                  f"{image_name}:")
            print("docker load -i OUT_PATH   # or: OUT_PATH | docker load, for a stream script")
            print(f"docker tag LOADED_IMAGE {shlex.quote(image_name)}")
            return
        if dry_show:
            content, _ = build_config._generate_dockerfile()
            print(content)
            build_config.cleanup()
            return

        self._do_build(build_config, args)

    def _inspect_image(self, image_name: str) -> Optional[Dict[str, Any]]:
        """Return docker's inspect data for an image, or None if it is missing or unreadable."""
        result = subprocess.run(
            ["docker", "image", "inspect", image_name],
            capture_output=True,
            text=True
        )
        if result.returncode != 0:
            return None
        try:
            image_info = json.loads(result.stdout)
        except ValueError:
            return None
        if not image_info:
            return None
        return image_info[0]

    def _image_build_times(self, image_name: str) -> Optional[Tuple[float, float]]:
        """Return (built_at, checked_at) for an image, or None if unknown.

        built_at is when the image's current content was built or loaded; it
        is what dependents compare against.  checked_at is when its sources
        were last confirmed to match it, which is later than built_at when a
        nix rebuild produced unchanged output; it is what the image's own
        sources compare against.

        Both come from the build cache when it has an entry for the image
        docker currently has under that name, and otherwise from docker's
        creation time.  A missing image, or an implausible creation time
        (eg. unix time 0 for nix images), is unknown.
        """
        info = self._inspect_image(image_name)
        if info is None:
            return None

        entry = self.build_cache.get_entry(image_name, info.get("Id"))
        if entry is not None and isinstance(entry.get("built-at"), (int, float)):
            built_at = float(entry["built-at"])
            checked_at = entry.get("checked-at")
            if not isinstance(checked_at, (int, float)) or checked_at < built_at:
                checked_at = built_at
            return built_at, float(checked_at)

        from datetime import datetime
        try:
            created = datetime.fromisoformat(
                info.get("Created", "").replace("Z", "+00:00")).timestamp()
        except ValueError:
            return None
        if created < PLAUSIBLE_IMAGE_CREATION_TIME:
            return None
        return created, created

    def _record_build(self, image_name: str, **extra):
        """Record in the build cache that image_name was just built or loaded."""
        info = self._inspect_image(image_name)
        if info is None or not info.get("Id"):
            print(f"Warning: cannot inspect {image_name}; not recording it in the build cache",
                  file=sys.stderr)
            return
        now = time.time()
        self.build_cache.update(image_name, {"image-id": info["Id"], "built-at": now, **extra})

    def _should_build_image(self, build_mode: str, build_config: BuildConfig, image_name: str,
                            dependency_images: List[str] = ()) -> bool:
        """Determine if image should be built based on build mode and staleness.

        In detect mode, the image is built if it doesn't exist or its build
        time is unknown, if any of its build sources is newer than it, or if
        any of dependency_images (its resolved docsuez image dependencies) is
        newer than it.  Build times come from _image_build_times.
        """
        if build_mode in ["yes", "force", "true"]:
            return True
        if build_mode in ["no", "false"]:
            return False

        # build_mode == "detect" (default)
        # A missing image or unknown build time means rebuild to be safe.
        times = self._image_build_times(image_name)
        if times is None:
            return True
        built_at, checked_at = times

        # Compare with build source mtimes (dockerfile + config)
        if build_config.get_newest_source_mtime() > checked_at:
            return True

        for dep_image in dependency_images:
            dep_times = self._image_build_times(dep_image)
            if dep_times is None or dep_times[0] > built_at:
                return True

        return False

    def _resolve_top_level_dependencies(self, build_config: BuildConfig, no_cache: bool,
                                        dry_run: bool) -> List[str]:
        """Resolve the docsuez image dependencies of the image being built or run.

        Dependencies use "detect" build mode.  Returns the resolved dependency
        image names (see _resolve_docsuez_dependencies).
        """
        # The top-level config counts as being resolved, so a dependency that
        # leads back to it is reported as a cycle.
        self._resolving_build_configs.append(build_config.config_path.resolve())
        images = self._resolve_docsuez_dependencies(
            build_config, build_mode="detect", no_cache=no_cache, dry_run=dry_run)
        self._resolving_build_configs.pop()
        return images

    def _resolve_docsuez_dependencies(self, build_config: BuildConfig, build_mode: str,
                                      no_cache: bool = False,
                                      dry_run: bool = False) -> List[str]:
        """Resolve and, if needed, build the docsuez image dependencies of a BuildConfig.

        Dependencies are the images named by {"from-docsuez": ...} and
        {"copy-from-docsuez": ...} entries in its dockerfile spec.  Each
        resolved image name is recorded on build_config, and the list of
        resolved image names is returned.

        Dependencies are resolved recursively, and each is checked (and built
        if needed) at most once per docsuez invocation.  The same build_mode
        (force/detect/skip) is applied to every dependency.  A dependency
        cycle is an error.

        With dry_run, dependency image names are resolved but nothing is
        inspected or built.
        """
        images = []
        for dep_spec in build_config.get_docsuez_dependencies():
            image = self._resolve_docsuez_dependency(dep_spec, build_mode, no_cache, dry_run)
            build_config.set_docsuez_image(dep_spec, image)
            images.append(image)
        return images

    def _resolve_docsuez_dependency(self, dep_spec: str, build_mode: str,
                                    no_cache: bool, dry_run: bool) -> str:
        """Resolve one docsuez dependency spec to an image name, building it if needed."""
        dep_config_path = self.searcher.find_build_config(dep_spec)
        if not dep_config_path:
            print(f"Error: docsuez image dependency '{dep_spec}' not found", file=sys.stderr)
            sys.exit(1)

        key = dep_config_path.resolve()
        if key in self._resolved_dependency_images:
            return self._resolved_dependency_images[key]
        if key in self._resolving_build_configs:
            cycle = self._resolving_build_configs[self._resolving_build_configs.index(key):]
            chain = " -> ".join(str(p) for p in cycle + [key])
            print(f"Error: docsuez image dependency cycle: {chain}", file=sys.stderr)
            sys.exit(1)

        self._resolving_build_configs.append(key)
        dep_config = BuildConfig(dep_config_path, self.searcher)
        dep_config.load()

        # Resolve deeper dependencies first, so that a rebuilt deeper
        # dependency is newer than this one and makes it stale in detect mode.
        nested_images = self._resolve_docsuez_dependencies(dep_config, build_mode, no_cache,
                                                           dry_run)

        dep_image_name = dep_config.get_builder_image_name()

        if not dry_run and self._should_build_image(build_mode, dep_config, dep_image_name,
                                                    nested_images):
            print(f"Building docsuez image dependency: {dep_image_name}...")
            sys.stdout.flush()
            dep_args = argparse.Namespace(image_spec=dep_spec, no_cache=no_cache, dry_show=False)
            self._do_build(dep_config, dep_args)

        dep_config.cleanup()
        self._resolving_build_configs.pop()
        self._resolved_dependency_images[key] = dep_image_name
        return dep_image_name

    def _do_build(self, build_config: BuildConfig, args):
        """Execute the docker build for a pre-loaded BuildConfig.

        build_config must already be loaded and its docsuez image
        dependencies resolved (see _resolve_docsuez_dependencies).  This is
        the inner build routine shared between cmd_build and
        _resolve_docsuez_dependency.
        """
        if build_config.get_nix_spec() is not None:
            self._do_nix_build(build_config)
            return

        build_cmd = ["docker", "build"]

        # Add --no-cache if requested
        if getattr(args, 'no_cache', False):
            build_cmd.append("--no-cache")

        # Add build args
        for key, value in build_config.get_build_args().items():
            build_cmd.extend(["--build-arg", f"{key}={value}"])

        # Add tag
        image_name = build_config.get_builder_image_name()
        build_cmd.extend(["-t", image_name])

        # Add dockerfile
        dockerfile = build_config.get_dockerfile()
        if dockerfile:
            build_cmd.extend(["-f", dockerfile])

        # Add context
        build_cmd.append(build_config.get_build_context_directory())

        print(f"Building image: {' '.join(build_cmd)}")
        try:
            subprocess.run(build_cmd, check=True)
        except subprocess.CalledProcessError as e:
            print(f"\nError: Image build failed with exit code {e.returncode}", file=sys.stderr)
            build_config.cleanup()
            sys.exit(1)
        finally:
            build_config.cleanup()
        self._record_build(image_name)

    def _do_nix_build(self, build_config: BuildConfig):
        """Build a nix config's image with nix and load it into docker.

        The load is skipped when the build cache shows the same nix output
        already loaded under the image name; the cache entry's checked-at
        time is refreshed instead, so detect mode stops re-checking.
        """
        image_name = build_config.get_builder_image_name()
        nix_cmd = build_config.get_nix_build_command()
        if shutil.which(nix_cmd[0]) is None:
            print(f"Error: '{nix_cmd[0]}' not found on PATH; it is needed to build "
                  f"{build_config.config_path}", file=sys.stderr)
            sys.exit(1)

        print(f"Building nix image: {shlex.join(nix_cmd)}")
        sys.stdout.flush()
        result = subprocess.run(nix_cmd, cwd=build_config.config_dir,
                                stdout=subprocess.PIPE, text=True)
        out_lines = [line for line in result.stdout.splitlines() if line.strip()]
        if result.returncode != 0 or not out_lines:
            print(f"\nError: nix build failed with exit code {result.returncode}", file=sys.stderr)
            sys.exit(1)
        out_path = out_lines[-1].strip()

        info = self._inspect_image(image_name)
        entry = self.build_cache.get_entry(image_name, info.get("Id") if info else None)
        if entry is not None and entry.get("nix-out-path") == out_path:
            print(f"Nix output unchanged; {image_name} is up to date")
            self.build_cache.update(image_name, {**entry, "checked-at": time.time()})
            return

        # dockerTools produces either an image tarball or (streamLayeredImage)
        # an executable that writes the image to stdout.
        print(f"Loading {out_path} into docker...")
        sys.stdout.flush()
        if os.path.isfile(out_path) and os.access(out_path, os.X_OK):
            stream = subprocess.Popen([out_path], stdout=subprocess.PIPE)
            load = subprocess.run(["docker", "load"], stdin=stream.stdout,
                                  stdout=subprocess.PIPE, text=True)
            stream.stdout.close()
            stream_rc = stream.wait()
        else:
            load = subprocess.run(["docker", "load", "-i", out_path],
                                  stdout=subprocess.PIPE, text=True)
            stream_rc = 0
        sys.stdout.write(load.stdout)
        if load.returncode != 0 or stream_rc != 0:
            print(f"\nError: docker load of {out_path} failed", file=sys.stderr)
            sys.exit(1)

        loaded = None
        for line in load.stdout.splitlines():
            for prefix in ("Loaded image: ", "Loaded image ID: "):
                if line.startswith(prefix):
                    loaded = line[len(prefix):].strip()
        if loaded is None:
            print("\nError: could not find the loaded image name in docker load output",
                  file=sys.stderr)
            sys.exit(1)

        if loaded != image_name:
            subprocess.run(["docker", "tag", loaded, image_name], check=True)
            # Drop the tag from the nix expression; the image stays under
            # image_name.  An image loaded by id only has no tag to drop.
            if not loaded.startswith("sha256:"):
                subprocess.run(["docker", "rmi", loaded], check=True,
                               stdout=subprocess.DEVNULL)

        self._record_build(image_name, **{"nix-out-path": out_path})

    def _generate_docker_run_script(self, script_file, config: DocsuezConfig, image_name: str,
                                     tsuez_mode: bool = False, tsuez_config: Optional[Dict[str, Any]] = None,
                                     session_name: Optional[str] = None, socket_dir: Optional[str] = None,
                                     command: Optional[List[str]] = None, extra_docker_args: Optional[List[str]] = None):
        """Generate docker run script content

        Args:
            script_file: File object to write to
            config: DocsuezConfig object
            image_name: Name of docker image
            tsuez_mode: If True, generate tsuez integration script
            tsuez_config: Tsuez configuration (required if tsuez_mode=True)
            session_name: Session name (required if tsuez_mode=True)
            socket_dir: Socket directory (required if tsuez_mode=True)
            command: Command to run (required if tsuez_mode=False)
            extra_docker_args: Extra arguments to pass to docker run (from -- separator)
        """
        f = script_file
        script_parts = config.get_docker_run_script()
        volumes = config.get_volumes()

        # Write script header
        f.write("#!/bin/bash\n")
        f.write("set -e\n\n")

        if tsuez_mode:
            f.write(f"export DOCSUEZ_ENV_NAME={session_name}\n\n")

        f.write("# Don't inherit container settings from an outer docsuez container\n")
        f.write('for _docsuez_var in $(compgen -v DOCSUEZ_CONTAINER_ || true); do unset "$_docsuez_var"; done\n\n')

        f.write("# Array for extra docker run arguments\n")
        f.write("DOCKER_RUN_EXTRAS=()\n")
        f.write("# Array of volume mounts, host:container[:options]\n")
        f.write("DOCSUEZ_VOLUMES=()\n\n")

        # Add user script parts
        for script_part in script_parts:
            f.write(f"# User script component\n")
            f.write(f"{script_part}\n\n")

        # Add configured volumes, expanded now that script parts have run
        f.write("# Configured volumes\n")
        for external, internal in volumes.items():
            f.write(f'DOCSUEZ_VOLUMES+=("{external}:{internal}")\n')
        if tsuez_mode:
            # Mount socket directory and the tsuez command
            tsuez_path = subprocess.run(["which", self.tsuez_cmd], capture_output=True, text=True, check=True).stdout.strip()
            f.write(f'DOCSUEZ_VOLUMES+=("{socket_dir}:/tsuez-dir")\n')
            f.write(f'DOCSUEZ_VOLUMES+=("{tsuez_path}:/usr/local/bin/tsuez:ro")\n')
        f.write("\n")
        f.write(VOLUME_PREPARE_SCRIPT)
        f.write("\n")

        # Build inner script for tsuez mode
        if tsuez_mode:
            tmux_cmd = ' '.join(tsuez_config["tmux_start_command"])
            f.write("# Build inner script for container\n")
            f.write("INNER_SCRIPT=$(cat <<'DOCSUEZ_INNER_TSUEZ_LAUNCH_SCRIPT'\n")
            f.write(f'export DOCSUEZ_ENV_NAME={session_name}\n')
            f.write('\n')

            # Add shell lines to run before tmux
            shell_lines = config.get_pre_tmux_script()
            if shell_lines:
                f.write('# User shell lines to run before tmux\n')
                for line in shell_lines:
                    f.write(f'{line}\n')
                f.write('\n')

            f.write('# Start tmux session in detached mode\n')
            f.write(f'{tmux_cmd}\n')
            f.write('\n')

            # Add shell lines to run after tmux starts
            post_shell_lines = config.get_post_tmux_script()
            if post_shell_lines:
                f.write('# User shell lines to run after tmux starts\n')
                for line in post_shell_lines:
                    f.write(f'{line}\n')
                f.write('\n')

            f.write('# Wait while tmux session exists\n')
            f.write(f'while tmux -S /tsuez-dir/default has-session -t {session_name} 2>/dev/null; do\n')
            f.write('  sleep 1\n')
            f.write('done\n')
            f.write("DOCSUEZ_INNER_TSUEZ_LAUNCH_SCRIPT\n")
            f.write(")\n\n")

        # Build docker run command
        if tsuez_mode:
            f.write("# Start docker container in background\n")
            f.write("docker_cmd=(\n")
            f.write("  docker run --rm -d\n")
            # Prepend username to container name unless DOCSUEZ_NO_USER_NAME_PREPEND is set
            if not os.environ.get("DOCSUEZ_NO_USER_NAME_PREPEND"):
                username = os.environ.get("USER", "unknown")
                container_name = f"{username}_{session_name}"
            else:
                container_name = session_name
            f.write(f"  --name {container_name}\n")
        else:
            f.write("# Build docker run command\n")
            f.write("docker_cmd=(\n")
            f.write("  docker run --rm -it\n")

        # Add volumes
        f.write('  "${_docsuez_volume_args[@]}"\n')

        # Add docker args
        for arg in config.get_docker_args():
            f.write(f"  {arg}\n")

        # Add DOCKER_RUN_EXTRAS
        f.write('  "${DOCKER_RUN_EXTRAS[@]}"\n')

        # Add extra docker args from command line (-- separator)
        if extra_docker_args:
            for arg in extra_docker_args:
                # Quote arguments that contain spaces
                if ' ' in arg:
                    f.write(f"  '{arg}'\n")
                else:
                    f.write(f"  {arg}\n")

        # Add tsuez environment variables
        if tsuez_mode:
            # Set environment variables from tsuez config
            if "env" in tsuez_config:
                for key, value in tsuez_config["env"].items():
                    if value:  # Only add non-empty values
                        f.write(f"  -e {key}={value}\n")

            # Set TMUX_TMPDIR and TSUEZ_MANAGED
            f.write("  -e TMUX_TMPDIR=/tsuez-dir\n")
            f.write(f"  -e TSUEZ_MANAGED={session_name}\n")

        # Add image name
        f.write(f"  {image_name}\n")

        # Add command or inner script
        if tsuez_mode:
            # Add bash command with inner script
            f.write("  bash -c\n")
            f.write('  "$INNER_SCRIPT"\n')
        else:
            # Add custom command
            for cmd_part in command:
                f.write(f"  {cmd_part}\n")

        f.write(")\n\n")

        # Execute docker command
        f.write('echo "Running: ${docker_cmd[@]}"\n')

        if tsuez_mode:
            # Execute and monitor
            f.write('CONTAINER_ID=$("${docker_cmd[@]}")\n')
            f.write('if [ $? -ne 0 ]; then\n')
            f.write('  echo "Error starting docker container" >&2\n')
            f.write('  exit 1\n')
            f.write('fi\n\n')

            f.write('echo "Container started: ${CONTAINER_ID:0:12}"\n')
            f.write('echo "Waiting for tmux server to start..."\n')
            f.write('sleep 1\n\n')

            # Verify container is still running
            f.write('# Check if container is still running\n')
            f.write('if ! docker ps -q -f "id=$CONTAINER_ID" | grep -q .; then\n')
            f.write('  echo "Error: Container exited immediately. Checking logs:" >&2\n')
            f.write('  docker logs "$CONTAINER_ID" >&2\n')
            f.write('  exit 1\n')
            f.write('fi\n\n')

            # Attach via tsuez
            tsuez_path = subprocess.run(["which", self.tsuez_cmd], capture_output=True, text=True, check=True).stdout.strip()
            f.write(f'echo "Attaching to session \'{session_name}\'..."\n')
            f.write(f'{tsuez_path} attach --socket-dir "{socket_dir}" "{session_name}"\n')
        else:
            # Simple execution
            f.write('"${docker_cmd[@]}"\n')

    def _call_tsuez_generate_config(self, session_name: str = None, base_name: str = None, color: str = None) -> Dict[str, Any]:
        """Call tsuez to generate docsuez config and return parsed JSON

        Reads three env vars:
        DOCSUEZ_TSUEZ_COLOR sets the tsuez session color explicitly (overrides hash-based selection).
        DOCSUEZ_TSUEZ_USE_HOSTNAME accepts 1/true/t/y/yes (enable) or 0/false/f/n/no (disable).
        DOCSUEZ_TSUEZ_HOSTNAME, if set along with DOCSUEZ_TSUEZ_USE_HOSTNAME, overrides the
        hostname name used in the hash (useful for containers with random hostnames).
        The explicit color takes precedence over hostname-based hashing.
        Either can be overridden by explicit CLI flags passed to docsuez.
        """
        import json as json_mod

        # Use explicit color arg if provided; otherwise check env var
        if not color:
            color = os.environ.get("DOCSUEZ_TSUEZ_COLOR")

        # Check hostname env vars
        _use_hostname_val = os.environ.get("DOCSUEZ_TSUEZ_USE_HOSTNAME", "").strip().lower()
        if _use_hostname_val in ("1", "true", "t", "y", "yes"):
            use_hostname = True
        elif _use_hostname_val in ("0", "false", "f", "n", "no"):
            use_hostname = False
        else:
            use_hostname = bool(_use_hostname_val)
        hostname_override = os.environ.get("DOCSUEZ_TSUEZ_HOSTNAME")

        cmd = [self.tsuez_cmd, "generate-docsuez-config"]
        if session_name:
            cmd.extend(["-s", session_name])
        if base_name:
            cmd.extend(["-b", base_name])
        if color:
            cmd.extend(["-c", color])
        elif use_hostname:
            if hostname_override:
                cmd.extend(["--hostname-override", hostname_override])
            else:
                cmd.append("--use-hostname")

        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            check=True
        )
        return json_mod.loads(result.stdout)

    def _run_with_tsuez(self, args, config: DocsuezConfig, image_name: str, config_name: str, extra_docker_args: Optional[List[str]] = None):
        """Run docker container with tsuez integration"""
        import tempfile
        import json as json_mod

        # Get session name and color from args if provided
        session_name = getattr(args, 'session_name', None)
        color = getattr(args, 'color', None)

        # Generate base name from config name and addons
        base_name = None
        if not session_name:
            # Start with the config name
            base_name = config_name
            # Add user-specified addon names (exclude default addons)
            if config.addons:
                base_name = f"{base_name}_{'_'.join(config.addons)}"

        # Generate tsuez config
        print("Generating tsuez configuration...")
        sys.stdout.flush()
        tsuez_config = self._call_tsuez_generate_config(session_name=session_name, base_name=base_name, color=color)

        socket_dir = tsuez_config["socket_dir"]
        session_name = tsuez_config["session_name"]

        # Generate shell script
        fd, script_path = tempfile.mkstemp(suffix=".sh", prefix="docsuez-tsuez-")

        try:
            with os.fdopen(fd, 'w') as f:
                self._generate_docker_run_script(
                    f, config, image_name,
                    tsuez_mode=True,
                    tsuez_config=tsuez_config,
                    session_name=session_name,
                    socket_dir=socket_dir,
                    extra_docker_args=extra_docker_args
                )

            os.chmod(script_path, 0o755)

            # If dry-show mode, print the config and script
            if getattr(args, 'dry_show', False):
                print("Tsuez config:")
                print(json_mod.dumps(tsuez_config, indent=2))
                print("\nGenerated script:")
                with open(script_path, 'r') as f:
                    print(f.read())
                return

            # Run the script
            result = subprocess.run(["bash", script_path])
            if result.returncode != 0:
                sys.exit(result.returncode)
        finally:
            if os.path.exists(script_path):
                os.unlink(script_path)

    def cmd_run(self, args):
        """Run a docker container from a run-docsuez.json config"""
        config_path = self.searcher.find_config(args.config)

        if not config_path:
            print(f"Config not found for '{args.config}'", file=sys.stderr)
            sys.exit(1)

        # Find default addons unless --no-default-addons is specified
        default_addons = []
        if not getattr(args, 'no_default_addons', False):
            default_addons = self.searcher.find_default_addons()
            if default_addons:
                print("Using default addons:")
                for name, path, kind in default_addons:
                    print(f"  {name} ({kind}): {path}")
                sys.stdout.flush()

        # Get user-specified addons from args
        addons = getattr(args, 'addon', []) or []

        config = DocsuezConfig(config_path, self.searcher,
                             addons=addons,
                             default_addons=default_addons)
        config.load()

        # Get image specifications
        image_builder = config.get_image_builder()
        image_name = config.get_runner_image_name()

        # Check for conflicting specifications
        if image_builder and image_name:
            print("Error: Cannot specify both 'image-builder' and 'image-name' in config", file=sys.stderr)
            sys.exit(1)

        # Determine which image to use
        build_config = None
        if image_name:
            # Direct image name specified, use it as-is
            print(f"Using image: {image_name}")
            sys.stdout.flush()
        else:
            # Use image builder (either explicit or fallback to config name)
            if not image_builder:
                # Fallback to using the config name as the image builder name
                image_builder = config_path.parent.name
                print(f"No image-builder or image-name specified, trying builder '{image_builder}'...", file=sys.stderr)

            build_config_path = self.searcher.find_build_config(image_builder)
            if not build_config_path:
                print(f"Build config not found for '{image_builder}'", file=sys.stderr)
                sys.exit(1)

            build_config = BuildConfig(build_config_path, self.searcher)
            build_config.load()
            image_name = build_config.get_builder_image_name()

            # Determine if we should build (skip if --dry-show is set, and
            # leave dependencies alone when building is disabled).  In detect
            # mode, dependencies are resolved (and rebuilt if stale) first, and
            # the image is rebuilt if any of them is newer than it.
            if not getattr(args, 'dry_show', False) and args.build not in ["no", "false"]:
                no_cache = getattr(args, 'no_cache', False)
                dep_images = self._resolve_top_level_dependencies(
                    build_config, no_cache=no_cache, dry_run=False)
                if self._should_build_image(args.build, build_config, image_name, dep_images):
                    print(f"Building image {image_name}...")
                    sys.stdout.flush()
                    self._do_build(build_config, argparse.Namespace(no_cache=no_cache))

        # Get extra docker args from command line
        extra_docker_args = getattr(args, 'extra_docker_args', None)

        # Check if we should use tsuez integration or custom command
        command = config.get_command()
        if not command:
            # Use tsuez integration
            self._run_with_tsuez(args, config, image_name, args.config, extra_docker_args)
            return

        # Custom command path - use script wrapper for DOCKER_RUN_EXTRAS support
        import tempfile
        fd, script_path = tempfile.mkstemp(suffix=".sh", prefix="docsuez-run-")

        try:
            with os.fdopen(fd, 'w') as f:
                self._generate_docker_run_script(
                    f, config, image_name,
                    tsuez_mode=False,
                    command=command,
                    extra_docker_args=extra_docker_args
                )

            os.chmod(script_path, 0o755)

            # If dry-show mode, print the script instead of running it
            if getattr(args, 'dry_show', False):
                with open(script_path, 'r') as f:
                    print(f.read())
            else:
                result = subprocess.run(["bash", script_path])
                if result.returncode != 0:
                    sys.exit(result.returncode)
        finally:
            if os.path.exists(script_path):
                os.unlink(script_path)

    def run(self):
        parser = argparse.ArgumentParser(
            description="Build and run Docker containers with tsuez integration",
            epilog="environment variables:\n"
                   "  DOCSUEZ_PATH    Colon-separated list of directories to search for\n"
                   "                  configuration files (overrides XDG directories)\n"
                   "  DOCSUEZ_NO_USER_NAME_PREPEND\n"
                   "                  If set, do not prepend $USER to docker image and\n"
                   "                  container names\n"
                   "  DOCSUEZ_TSUEZ_COLOR\n"
                   "                  Background color for tsuez sessions (name or hex value);\n"
                   "                  overrides hash-based color selection; can be overridden\n"
                   "                  by the --color CLI flag\n"
                   "  DOCSUEZ_TSUEZ_USE_HOSTNAME\n"
                   "                  Include the real hostname in the tsuez color hash, giving\n"
                   "                  different colors per machine; accepts 1/true/t/y/yes or\n"
                   "                  0/false/f/n/no; ignored when DOCSUEZ_TSUEZ_COLOR or\n"
                   "                  --color is set\n"
                   "  DOCSUEZ_TSUEZ_HOSTNAME\n"
                   "                  If DOCSUEZ_TSUEZ_USE_HOSTNAME is set, use this name as the\n"
                   "                  hostname in the hash instead of the real hostname; useful\n"
                   "                  on containers with random hostnames (e.g. docker)\n"
                   "  TMPDIR          Directory for temporary files such as generated\n"
                   "                  Dockerfiles and run scripts (default: /tmp)\n",
            formatter_class=argparse.RawDescriptionHelpFormatter,
        )
        subparsers = parser.add_subparsers(dest="command", help="Commands")

        # list-configurations command
        subparsers.add_parser("list-configurations", help="List available configuration names")

        # list-addons command
        subparsers.add_parser("list-addons", help="List available addon names")

        # list-builds command
        subparsers.add_parser("list-builds", help="List available build names")

        # build command
        build_parser = subparsers.add_parser("build", help="Build a docker image")
        build_parser.add_argument("image_spec", help="Image spec (directory name or path)")
        build_parser.add_argument("--dry-show", action="store_true",
                                  help="Show the assembled Dockerfile without building")
        build_parser.add_argument("--no-cache", action="store_true",
                                  help="Pass --no-cache to docker build")

        # run command
        run_parser = subparsers.add_parser("run",
            help="Run a docker container",
            epilog="Use -- to pass additional arguments to docker run, e.g.: docsuez run my-env -- -v /host/path:/container/path")
        run_parser.add_argument("config", help="Config name or path")
        run_parser.add_argument("--build", "-b", default="detect",
                                choices=["detect", "yes", "force", "true", "no", "false"],
                                help="Build mode: detect (default, build if out of date), yes/force/true (always build), no/false (never build)")
        run_parser.add_argument("--addon", "-a", action="append", dest="addon",
                                help="Add configuration addon (can be specified multiple times)")
        run_parser.add_argument("--no-default-addons", action="store_true",
                                help="Skip loading default addons (*.default.run-docsuez.json)")
        run_parser.add_argument("--session-name", "-s", help="Name for the tmux session")
        run_parser.add_argument("--color", "-c", help="Background color for the tmux session (name or hex value)")
        run_parser.add_argument("--dry-show", action="store_true",
                                help="Show the run script without executing it")
        run_parser.add_argument("--no-cache", action="store_true",
                                help="Pass --no-cache to docker build")

        # Handle -- separator for passing extra args to docker run
        extra_docker_args = None
        argv = sys.argv[1:]  # Skip program name
        if '--' in argv:
            separator_idx = argv.index('--')
            extra_docker_args = argv[separator_idx + 1:]
            argv = argv[:separator_idx]
            args = parser.parse_args(argv)
        else:
            args = parser.parse_args()

        # Store extra docker args in args object for cmd_run to use
        if extra_docker_args is not None:
            args.extra_docker_args = extra_docker_args
        else:
            args.extra_docker_args = None

        if not args.command:
            parser.print_help()
            sys.exit(1)

        # Dispatch to appropriate handler (convert hyphens to underscores)
        handler_name = f"cmd_{args.command.replace('-', '_')}"
        handler = getattr(self, handler_name)
        handler(args)


if __name__ == "__main__":
    docsuez = Docsuez()
    docsuez.run()
