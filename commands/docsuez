#!/usr/bin/env python3
"""
docsuez - Build and run Docker containers with tsuez integration

Implementation:
- tsuez runs OUTSIDE of docker and generates tmux configuration
- Docker container runs tmux server in background with shared socket directory
- tsuez attaches to the tmux server inside docker as foreground process
- Docker exits when inner tmux server exits
- Socket is accessible both inside and outside docker

Configuration File Examples:

run-docsuez.json - Specifies how to run a container:
{
  "image-builder": "my-dev-env",
  "image-name": "ubuntu:22.04",
  "volumes": {
    "$HOME/projects": "/workspace",
    "$HOME/.ssh": "/root/.ssh"
  },
  "docker-args": ["--network=host", "--privileged"],
  "command": ["bash"],
  "tmux-socket-dir": "/tmp/tmux-sockets",
  "docker-run-script": ["echo 'Setting up...'", "DOCKER_RUN_EXTRAS+=(--hostname myhost)"],
  "pre-tmux-script": ["export FOO=bar", "export QUUX=aoeu"],
  "post-tmux-script": ["echo 'Tmux started!'", "touch /tmp/setup-complete"],
  "include": ["base-config"],
  "tags": {
    "dev": {
      "docker-args": ["--cap-add=SYS_PTRACE"],
      "docker-run-script": ["DOCKER_RUN_EXTRAS+=(-e \"DEV_MODE=1\")"]
    }
  }
}

"docker-run-script" may be a string, a list of strings, or a dict mapping
numeric keys (as strings, e.g. "0", "100") to a string or list of strings.
Parts are ordered by key, lowest first; plain strings and lists count as key
50.  Parts from different configs/addons are merged, never replaced; parts at
the same key keep their merge order.

"pre-tmux-script" uses the same forms and ordering, but its lines run inside
the container before the tmux server starts.

Volumes: "volumes" maps host paths to container paths.  Both sides are
expanded by bash (in double quotes) after all docker-run-script parts have
run, so they can use variables set there (eg. $DOCSUEZ_CONTAINER_HOME).  They
are appended to the DOCSUEZ_VOLUMES bash array ("host:container[:options]"),
which docker-run-script parts may also append to directly instead of adding
-v to DOCKER_RUN_EXTRAS.  Before docker runs, missing host paths are created,
and a mount nested inside another mount gets its mountpoint pre-created in
the enclosing mount's host directory, so files and directories are owned by
the invoking user rather than created by docker as root.

The generated script unsets any inherited DOCSUEZ_CONTAINER_* variables
before running docker-run-script parts.

Note: Only one of "image-builder" or "image-name" should be specified:
- "image-builder": References a build-docsuez.json to build/use an image
- "image-name": Directly specifies a Docker image name to run (e.g., "ubuntu:22.04")
- If neither is specified, will look for a builder with the same name as the run config

build-docsuez.json - Specifies how to build an image:
{
  "dockerfile": [
    {"relative-path": "Dockerfile.base"},
    {"text": ["RUN apt install cowsay", "RUN apt install fortune"]},
    {"bash-print-text": "echo 'RUN echo Built on '$(date)"},
    {"search-merge": "build-fragments/my-dev-env/after-packages"},
    {"relative-path": "Dockerfile.extra"}
  ],
  "build-context-directory": ".",
  "image-name-postfix": "my-dev-env:latest",
  "build-args": {
    "BASE_IMAGE": "ubuntu:22.04"
  }
}

"search-merge" is an optional Dockerfile extension point.  Its relative path
is checked under every docsuez search path.  Each match may be a JSON file or
a directory whose immediate children are regular *.json files.  A JSON file
contains one dockerfile entry, a list of entries, or numeric keys mapping to
an entry or list of entries.  Unkeyed forms use position 50.  Contributions
are ordered by position, search-path order, filename, and list order.  No
matches is a no-op, while a found invalid path or contribution is an error.
Imported relative paths and bash programs use their JSON file's directory.
Nested search-merge entries are allowed; cycles are errors.

To build FROM another docsuez-managed image, use a "from-docsuez" entry
inside the "dockerfile" spec list.  It is an alternative to keys like
"text" and "relative-path" and controls where the FROM line appears in
the assembled Dockerfile.  To copy files out of another docsuez-managed
image, use a "copy-from-docsuez" entry the same way:
{
  "dockerfile": [
    {"from-docsuez": "my-builder-image", "as": "builder"},
    {"text": ["RUN make", "RUN make install DESTDIR=/out"]},
    {"from-docsuez": "my-base-image"},
    {"text": ["COPY --from=builder /out/ /"]},
    {"copy-from-docsuez": "my-tools-image", "src": "/usr/local/bin/tool", "dst": "/usr/local/bin/"},
    {"copy-from-docsuez": "my-tools-image", "src": ["/etc/a.conf", "/etc/b.conf"], "dst": "/etc/"}
  ]
}

docsuez resolves each referenced docsuez image (building it first if
needed), then substitutes its resolved Docker image name into the
assembled Dockerfile in place of the entry:
- {"from-docsuez": IMAGE} becomes "FROM <resolved IMAGE>".
  The optional "as" key adds a stage name: "FROM <resolved IMAGE> AS NAME".
  The stage name can be used in ordinary entries, eg. "COPY --from=NAME ...".
- {"copy-from-docsuez": IMAGE, "src": SRC, "dst": DST} becomes
  "COPY --from=<resolved IMAGE> SRC... DST".  "src" is a path or a list of
  paths; "src" and "dst" are required.
Both kinds of entry can appear any number of times, eg. for multi-stage
builds.  Other keys in these entries are an error.

Each referenced docsuez image is checked (and built if needed) at most once
per docsuez invocation, however many times it is referenced, directly or
through other docsuez images.  A cycle of references is an error.
When checking whether an image is out of date (eg. "run" in its default
"--build detect" mode), an image is rebuilt if any docsuez image it
references is newer than it, as well as when its own sources changed.
This applies transitively, since rebuilt dependencies are newer.
"build --dry-show" resolves referenced image names without building them.

Nix-built images: a build-docsuez.json may have a "nix" key instead of
"dockerfile", naming a nix expression that evaluates to a dockerTools image
(a tarball, or a streamLayeredImage stream script):
{"nix": {"file": "image.nix", "attr": "devImage", "args": {"foo": "bar"}}}
{"nix": {"flake": ".#devImage"}}
"file" is relative to the config directory; "attr" and "args" (passed as
--argstr) are optional and only apply to "file".  "flake" is evaluated with
the config directory as the working directory.  "nix" cannot be combined
with "dockerfile", "build-args", or "build-context-directory".  docsuez runs
nix-build (or nix build, for flakes), loads the result with docker load, and
tags it with the usual docsuez image name, so run configs and
from-docsuez / copy-from-docsuez entries use nix images like any other.
To be run directly, a nix image needs at least bash, tmux, coreutils, a
writable /tmp, and whatever the enabled addons use; to be built FROM with
RUN lines, it needs /bin/sh (eg. dockerTools.binSh).
Out-of-date checks for nix images compare the build cache (below) with the
config and every *.nix and flake.lock file under the config directory,
without evaluating nix; use "--build force" after changing inputs outside
it (eg. a nixpkgs update).  A forced build still skips docker load when the
nix output is unchanged.

Build cache: docsuez records when it builds or loads each image in
$XDG_CACHE_HOME/docsuez/build-cache.json (default ~/.cache), along with the
docker image id.  Out-of-date checks use that time while docker still has
the same image id under that name, and otherwise fall back to docker's
creation time.  An image with no cache entry and a creation time near unix
time 0 (eg. a nix dockerTools image) counts as out of date.

Note:
- Unless environment variable $DOCSUEZ_NO_USER_NAME_PREPEND is set, the $USER
  variable will be prepended to docker image and container names.
"""

import argparse
import fcntl
import json
import math
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Dict, List, Optional, Any, Tuple


def _strip_comment_keys(data):
    """Recursively remove any dict keys starting with '#'.

    JSON does not support comments.  This allows users to "comment out" a
    config key by prefixing it with '#'; those keys are silently ignored
    when the config is loaded.
    """
    if isinstance(data, dict):
        return {k: _strip_comment_keys(v) for k, v in data.items() if not k.startswith('#')}
    if isinstance(data, list):
        return [_strip_comment_keys(item) for item in data]
    return data


RUN_SCRIPT_DEFAULT_KEY = 50


def _normalize_run_script(value, name="docker-run-script") -> Dict[float, List[str]]:
    """Normalize an ordered script value to {numeric_key: [lines]}."""
    if value is None:
        return {}
    if isinstance(value, str):
        return {RUN_SCRIPT_DEFAULT_KEY: [value]}
    if isinstance(value, list):
        return {RUN_SCRIPT_DEFAULT_KEY: list(value)}
    if isinstance(value, dict):
        result = {}
        for key, part in value.items():
            if isinstance(key, (int, float)):
                num = key
            else:
                try:
                    num = float(key)
                except ValueError:
                    print(f"Error: {name} key '{key}' is not a number",
                          file=sys.stderr)
                    sys.exit(1)
            lines = [part] if isinstance(part, str) else list(part)
            result.setdefault(num, []).extend(lines)
        return result
    print(f"Error: invalid {name} value: {value!r}", file=sys.stderr)
    sys.exit(1)


def _merge_run_script(base, overlay, name="docker-run-script") -> Dict[float, List[str]]:
    """Merge ordered script values; same-key parts are concatenated."""
    result = {k: list(v) for k, v in _normalize_run_script(base, name).items()}
    for key, lines in _normalize_run_script(overlay, name).items():
        result.setdefault(key, []).extend(lines)
    return result


