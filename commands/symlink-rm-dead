#!/usr/bin/env python3
"""Delete broken symlinks in a directory.

With --dry, list broken symlinks without deleting them.
With --wet, delete them (listing each as it is deleted).
"""

import argparse
import os
import sys


def is_broken_symlink(path):
    return os.path.islink(path) and not os.path.exists(path)


def candidate_paths(directory, recursive):
    if recursive:
        # os.walk does not follow symlinked directories by default.
        for root, dirs, files in os.walk(directory):
            for name in dirs + files:
                yield os.path.join(root, name)
    else:
        with os.scandir(directory) as entries:
            for entry in entries:
                yield entry.path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--dry", action="store_true", help="list broken symlinks only")
    mode.add_argument("--wet", action="store_true", help="delete broken symlinks")
    parser.add_argument("--recursive", "-r", action="store_true", help="descend into subdirectories")
    parser.add_argument("directory", nargs="?", default=".", help="directory to scan (default: .)")
    args = parser.parse_args()

    if not os.path.isdir(args.directory):
        parser.error(f"not a directory: {args.directory}")

    status = 0
    for path in candidate_paths(args.directory, args.recursive):
        if not is_broken_symlink(path):
            continue
        print(path)
        if args.wet:
            try:
                os.unlink(path)
            except OSError as e:
                print(f"error removing {path}: {e}", file=sys.stderr)
                status = 1
    return status


if __name__ == "__main__":
    sys.exit(main())
