;; Floatile demo bar: everything the Waybar configuration showed, plus an
;; application menu and a power menu.  One `bar' window per vmonitor, opened
;; by floatile-eww-bar with the vmonitor's name as VMONITOR and the monitor eww
;; should put it on as MONITOR.
;;
;; floatile-eww-bar starts the eww daemon in this directory, so scripts/ is
;; relative to it; commands in handlers name it through EWW_CONFIG_DIR.

;; ---------------------------------------------------------------------------
;; Data
;; ---------------------------------------------------------------------------

(deflisten floatile :initial "{}" "scripts/floatile-bars.scm")
(deflisten mpris :initial "{\"markup\":\"\",\"shown\":false}" "scripts/mpris.scm")
(deflisten volume :initial "{\"markup\":\"\",\"muted\":false}" "scripts/volume.scm")
(deflisten gamma-temperature :initial "" "scripts/gammarelay-watch.sh {t}")
(deflisten gamma-brightness :initial "" "scripts/gammarelay-watch.sh {bp}")
(deflisten gamma-gamma :initial "" "scripts/gammarelay-watch.sh {g}")
(deflisten lightdark :initial "" "scripts/lightdark.sh")

(defpoll idle-inhibit :interval "5s" "wayland-idle-inhibit status")
(defpoll mooncrater :interval "1s" "cat /tmp/mooncrater-input-status 2>/dev/null || echo 'MC: inactive'")
(defpoll network :interval "5s" :initial "{\"text\":\"\",\"tooltip\":\"\",\"class\":\"\"}" "scripts/network.scm")
(defpoll temperature :interval "5s"
  "cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | sort -n | tail -1")
(defpoll backlight :interval "2s"
  "b=$(ls /sys/class/backlight 2>/dev/null | head -1); [ -n \"$b\" ] && echo $(( 100 * $(cat /sys/class/backlight/$b/brightness) / $(cat /sys/class/backlight/$b/max_brightness) )) || echo ''")
(defpoll battery :interval "10s" :initial "{\"text\":\"\",\"class\":\"\",\"batteries\":[]}" "scripts/battery.scm")
(defpoll clock :interval "10s" "date '+%a, %Y-%m-%d %H:%M'")
(defpoll calendar :interval "600s" "cal")
;; No :initial, so eww runs the script at startup; with one, the menu would
;; stay empty until the first interval passed.
(defpoll apps :interval "300s" "scripts/apps.scm")

;; How the window list shows each window: "icon+name", "icon", or "name".
;; With "icon", a window with no icon found still shows its name.
(defvar window-list-style "icon+name")

;; The index in `apps' of the category the application menu shows, -1 for
;; the list of categories.
(defvar menu-category -1)
;; The power action waiting to be confirmed, "" for none.
(defvar power-confirm "")

;; ---------------------------------------------------------------------------
;; Windows
;; ---------------------------------------------------------------------------

(defwindow bar [vmonitor monitor]
  :monitor monitor
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "30px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :namespace "floatile-bar"
  (bar :vmonitor vmonitor :monitor monitor))

(defwindow menu [monitor]
  :monitor monitor
  :geometry (geometry :x "0px" :y "0px" :width "320px" :anchor "top left")
  :stacking "overlay"
  :namespace "floatile-bar-menu"
  (app-menu :monitor monitor))

(defwindow batteries [monitor]
  :monitor monitor
  :geometry (geometry :x "0px" :y "0px" :width "280px" :anchor "top right")
  :stacking "overlay"
  :namespace "floatile-bar-batteries"
  (battery-list))

(defwindow calendar-popup [monitor]
  :monitor monitor
  :geometry (geometry :x "0px" :y "0px" :anchor "top right")
  :stacking "overlay"
  :namespace "floatile-bar-calendar"
  (box :class "popup calendar-popup"
    ;; GTK's calendar: opens on today; its arrows change month and year.
    (calendar :show-week-numbers true)))

(defwindow display [monitor]
  :monitor monitor
  :geometry (geometry :x "0px" :y "0px" :width "300px" :anchor "top right")
  :stacking "overlay"
  :namespace "floatile-bar-display"
  (display-controls))

(defwindow power [monitor]
  :monitor monitor
  :geometry (geometry :x "0px" :y "0px" :width "220px" :anchor "top right")
  :stacking "overlay"
  :namespace "floatile-bar-power"
  (power-menu :monitor monitor))

;; ---------------------------------------------------------------------------
;; The bar
;; ---------------------------------------------------------------------------

(defwidget bar [vmonitor monitor]
  (centerbox :class "bar" :orientation "h"
    (box :class "left" :space-evenly false :halign "start"
      (button :class "start" :tooltip "Applications"
              :onclick "eww -c ${EWW_CONFIG_DIR} open --toggle menu --id menu-${monitor} --arg monitor='${monitor}' && eww -c ${EWW_CONFIG_DIR} update menu-category=-1"
        "")
      (button :class "terminal" :onclick "vlaunch terminal" "T>")
      (workspaces :vmonitor vmonitor)
      ;; Click to cycle the layout of this vmonitor's workspace, like
      ;; super+space; activating it first makes cycle-layout act on it rather
      ;; than on whichever vmonitor is active.
      (button :class "layout"
              :tooltip "Layout: click to cycle"
              :onclick "floatilectl activate-workspace ${floatile?.vmonitors?.[vmonitor]?.workspace_id ?: -1} >/dev/null && floatilectl cycle-layout >/dev/null"
        {floatile?.vmonitors?.[vmonitor]?.layout ?: ""})
      (windows :vmonitor vmonitor))
    (box)
    (box :class "right" :space-evenly false :halign "end"
      (eventbox :visible {mpris.shown}
                :onclick "playerctl play-pause"
                :onrightclick "playerctl next"
                :onmiddleclick "playerctl previous"
                :tooltip "Click: play or pause; right click: next; middle click: previous"
        (label :class "module mpris" :markup {mpris.markup}))
      (button :class "module idle ${idle-inhibit == 'inhibited' ? 'inhibited' : 'no-inhibit'}"
              :onclick "wayland-idle-inhibit toggle"
        {idle-inhibit == "inhibited" ? "NOSS" : "SCS"})
      (label :class "module mooncrater" :text "⌨ ${mooncrater}")
      (eventbox :onclick "nm-connection-editor &"
        (label :class "module network ${network.class}" :text {network.text} :tooltip {network.tooltip}))
      ;; Temperature, CPU, and memory open the system monitor vlaunch names;
      ;; set sysmonitor in vlaunchrc to choose it per machine.
      (eventbox :visible {temperature != ""} :onclick "vlaunch sysmonitor"
        (label :class "module temperature ${temperature != '' && temperature / 1000 >= 80 ? 'critical' : ''}"
               :text "${temperature == '' ? '' : round(temperature / 1000, 0)}°C${temperature == '' ? '' : temperature / 1000 < 50 ? '' : temperature / 1000 < 80 ? '' : ''}"))
      (eventbox :onclick "vlaunch sysmonitor"
        (label :class "module cpu" :text "${round(EWW_CPU.avg, 0)}%"))
      (eventbox :onclick "vlaunch sysmonitor"
        (label :class "module memory" :text "${round(EWW_RAM.used_mem_perc, 0)}%🐏"))
      ;; wl-gammarelay-rs: scroll to change, click for the display popup's
;; sliders; hidden while its daemon is not running.
      (eventbox :visible {gamma-temperature != ""}
                :onclick "eww -c ${EWW_CONFIG_DIR} open --toggle display --id display-${monitor} --arg monitor='${monitor}'"
                :onscroll "[ {} = up ] && busctl --user -- call rs.wl-gammarelay / rs.wl.gammarelay UpdateTemperature n +100 || busctl --user -- call rs.wl-gammarelay / rs.wl.gammarelay UpdateTemperature n -100"
        (label :class "module gamma" :text "${gamma-temperature} "))
      (eventbox :visible {gamma-brightness != ""}
                :onclick "eww -c ${EWW_CONFIG_DIR} open --toggle display --id display-${monitor} --arg monitor='${monitor}'"
                :onscroll "[ {} = up ] && busctl --user -- call rs.wl-gammarelay / rs.wl.gammarelay UpdateBrightness d +0.02 || busctl --user -- call rs.wl-gammarelay / rs.wl.gammarelay UpdateBrightness d -0.02"
        (label :class "module gamma" :text "${gamma-brightness}% "))
      (eventbox :visible {gamma-gamma != ""}
                :onclick "eww -c ${EWW_CONFIG_DIR} open --toggle display --id display-${monitor} --arg monitor='${monitor}'"
                :onscroll "[ {} = up ] && busctl --user -- call rs.wl-gammarelay / rs.wl.gammarelay UpdateGamma d +0.02 || busctl --user -- call rs.wl-gammarelay / rs.wl.gammarelay UpdateGamma d -0.02"
        (label :class "module gamma" :text "γ${gamma-gamma}"))
      ;; Red mode, Floatile's own night light: click to turn on or off,
      ;; scroll to make it warmer or cooler.  An alternative to wl-gammarelay-rs.
      (eventbox :onclick "floatilectl night-light toggle >/dev/null"
                :onscroll "[ {} = up ] && floatilectl night-light adjust 200 >/dev/null || floatilectl night-light adjust -200 >/dev/null"
                :tooltip "Red mode: click to turn on or off, scroll to change how red"
        (label :class "module night-light ${(floatile?.night_light?.on ?: false) ? 'on' : 'off'}"
               :text {(floatile?.night_light?.on ?: false) ? "RED ${floatile.night_light.temperature}K" : "red"}))
      (eventbox :visible {lightdark != ""}
                :onclick "lightdark-status toggle >/dev/null 2>&1 &"
                :tooltip "Light or dark theme: click to switch"
        (label :class "module lightdark ${lightdark}" :text {lightdark == "light" ? " light" : " dark"}))
      (eventbox :visible {backlight != ""}
                :onclick "eww -c ${EWW_CONFIG_DIR} open --toggle display --id display-${monitor} --arg monitor='${monitor}'"
                :onscroll "[ {} = up ] && state backlight inc || state backlight dec"
        (label :class "module backlight" :text "${backlight}%∠💡"))
      (systray :class "module tray" :spacing 10 :icon-size 18)
      (eventbox :onclick "pavucontrol &"
                :onscroll "[ {} = up ] && pactl set-sink-volume @DEFAULT_SINK@ +5% || pactl set-sink-volume @DEFAULT_SINK@ -5%"
        (label :class "module volume ${volume.muted ? 'muted' : ''}" :markup {volume.markup}))
      (battery :monitor monitor)
      (eventbox :onclick "eww -c ${EWW_CONFIG_DIR} open --toggle calendar-popup --id calendar-${monitor} --arg monitor='${monitor}'"
        (label :class "module clock" :text clock :tooltip calendar))
      (button :class "power" :tooltip "Power"
              :onclick "eww -c ${EWW_CONFIG_DIR} open --toggle power --id power-${monitor} --arg monitor='${monitor}' && eww -c ${EWW_CONFIG_DIR} update power-confirm=''"
        ""))))

(defwidget workspaces [vmonitor]
  (box :class "workspaces" :space-evenly false
    (for ws in {floatile?.vmonitors?.[vmonitor]?.workspaces ?: []}
      (button :class "${ws.active ? 'active' : ws.shown ? 'shown' : ''} ${ws.urgent ? 'urgent' : ''}"
              :onclick "floatilectl activate-workspace ${ws.id}"
        {ws.name}))))

(defwidget windows [vmonitor]
  (box :class "windows" :space-evenly false
    (for w in {floatile?.vmonitors?.[vmonitor]?.windows ?: []}
      ;; activate-window focuses and raises the window, restoring it if
      ;; minimized.  The class is the window's tags: focused, minimized,
      ;; floating, maximized, fullscreen, and urgent are styled; others are
      ;; left alone.
      (button :class "window ${w.class}"
              :tooltip {w.tooltip}
              :onclick "floatilectl activate-window ${w.id}"
        (box :space-evenly false :spacing 4
          (image :visible {window-list-style != "name" && w.icon_path != ""}
                 :path {w.icon_path} :image-width 16 :image-height 16)
          (label :visible {window-list-style != "icon" || w.icon_path == ""}
                 :class "name" :text {w.label})
          ;; Floating, maximized, and fullscreen windows are marked.
          (label :class "marks"
                 :visible {w.marks != ""}
                 :text {w.marks}))))))

;; Shown even with no system battery, as NO_BAT, so peripheral batteries
;; stay one click away.
(defwidget battery [monitor]
  (eventbox :onclick "eww -c ${EWW_CONFIG_DIR} open --toggle batteries --id batteries-${monitor} --arg monitor='${monitor}'"
            :tooltip "Batteries: click for the list"
    (label :class "module battery ${battery.class}" :text {battery.text})))

;; ---------------------------------------------------------------------------
;; Application menu: categories, then the applications of one
;; ---------------------------------------------------------------------------

(defwidget app-menu [monitor]
  (box :class "popup menu" :orientation "v" :space-evenly false
    (box :visible {menu-category < 0} :orientation "v" :space-evenly false
      (for category in apps
        (button :class "menu-item"
                :onclick "eww -c ${EWW_CONFIG_DIR} update menu-category=${category.index}"
          (label :xalign 0 :text "${category.label}  ›"))))
    (box :visible {menu-category >= 0} :orientation "v" :space-evenly false
      (button :class "menu-item back" :onclick "eww -c ${EWW_CONFIG_DIR} update menu-category=-1"
        (label :xalign 0 :text "‹  Back"))
      (scroll :vscroll true :hscroll false :height 480
        (box :orientation "v" :space-evenly false
          ;; One loop over the chosen category's applications: a loop nested
          ;; in the loop over categories showed every category empty.
          (for app in {menu-category >= 0 ? apps[menu-category].apps : "[]"}
            (button :class "menu-item"
                    :onclick "${EWW_CONFIG_DIR}/scripts/launch-app.scm '${app.id}' ; eww -c ${EWW_CONFIG_DIR} close menu-${monitor}"
              (box :space-evenly false :spacing 8
                ;; Drawn from the icon's file, which eww scales, so every
                ;; icon is the same size; by name only when no file was found.
                (image :visible {app.icon_path != ""} :path {app.icon_path}
                       :image-width 24 :image-height 24)
                (image :visible {app.icon_path == ""} :icon {app.icon} :icon-size "large-toolbar")
                (label :xalign 0 :limit-width 32 :text {app.name})))))))))

;; ---------------------------------------------------------------------------
;; Battery list: every battery, system ones first
;; ---------------------------------------------------------------------------

(defwidget battery-list []
  (box :class "popup battery-list" :orientation "v" :space-evenly false
    (label :visible {arraylength(battery.batteries) == 0} :class "battery-row" :xalign 0
           :text "No batteries")
    (for b in {battery.batteries}
      (box :class "battery-row ${b.class}" :space-evenly false :spacing 8
        (box :orientation "v" :space-evenly false :hexpand true
          (label :class "battery-name" :xalign 0 :limit-width 28 :text {b.name})
          (label :class "battery-status" :xalign 0
                 :text "${b.status}${b.detail == '' ? '' : ', ' + b.detail}"))
        (label :class "battery-capacity" :xalign 1 :text {b.capacity})))))

;; ---------------------------------------------------------------------------
;; Display popup: wl-gammarelay-rs color and the backlight, as sliders
;; ---------------------------------------------------------------------------
;; A friendlier tool would be nice later: saved profiles (eg. day, evening,
;; film), calibration aids, and per-display settings.  No such GUI for
;; wl-gammarelay-rs was found, so this covers its three settings.

;; Each slider's command gets the value as {}, possibly with a fraction.
(defwidget display-controls []
  (box :class "popup display-controls" :orientation "v" :space-evenly false
    (label :visible {gamma-temperature == "" && backlight == ""} :class "display-row" :xalign 0
           :text "Neither wl-gammarelay-rs nor a backlight is available")
    (box :visible {gamma-temperature != ""} :orientation "v" :space-evenly false
      (display-slider :title "Temperature" :text "${gamma-temperature}K"
                      :min 1000 :max 10000 :digits 0
                      :value {gamma-temperature == "" ? 6500 : gamma-temperature}
                      :onchange "busctl --user set-property rs.wl-gammarelay / rs.wl.gammarelay Temperature q $(printf %.0f {})")
      ;; At least 10%, so the screen can't be dimmed to black from here.
      (display-slider :title "Brightness" :text "${gamma-brightness}%"
                      :min 10 :max 100 :digits 0
                      :value {gamma-brightness == "" ? 100 : gamma-brightness}
                      :onchange "busctl --user set-property rs.wl-gammarelay / rs.wl.gammarelay Brightness d $(awk 'BEGIN { print {} / 100 }')")
      (display-slider :title "Gamma" :text {gamma-gamma}
                      :min 0.3 :max 2.5 :digits 2
                      :value {gamma-gamma == "" ? 1 : gamma-gamma}
                      :onchange "busctl --user set-property rs.wl-gammarelay / rs.wl.gammarelay Gamma d {}")
      (button :class "menu-item"
              :onclick "busctl --user set-property rs.wl-gammarelay / rs.wl.gammarelay Temperature q 6500 ; busctl --user set-property rs.wl-gammarelay / rs.wl.gammarelay Brightness d 1 ; busctl --user set-property rs.wl-gammarelay / rs.wl.gammarelay Gamma d 1"
        "Reset color"))
    (box :visible {backlight != ""} :orientation "v" :space-evenly false
      (display-slider :title "Backlight" :text "${backlight}%"
                      :min 1 :max 100 :digits 0
                      :value {backlight == "" ? 100 : backlight}
                      :onchange "state backlight set $(printf %.0f {})"))))

(defwidget display-slider [title text min max digits value onchange]
  (box :class "display-row" :orientation "v" :space-evenly false
    (box :space-evenly false
      (label :class "display-label" :xalign 0 :hexpand true :text title)
      (label :class "display-value" :xalign 1 :text text))
    (scale :min min :max max :round-digits digits :value value :onchange onchange)))

;; ---------------------------------------------------------------------------
;; Power menu: each action asks first
;; ---------------------------------------------------------------------------

(defwidget power-menu [monitor]
  (box :class "popup power-menu" :orientation "v" :space-evenly false
    (box :visible {power-confirm == ""} :orientation "v" :space-evenly false
      (button :class "menu-item" :onclick "eww -c ${EWW_CONFIG_DIR} update power-confirm=lock" "Lock")
      (button :class "menu-item" :onclick "eww -c ${EWW_CONFIG_DIR} update power-confirm=logout" "Log out")
      (button :class "menu-item" :onclick "eww -c ${EWW_CONFIG_DIR} update power-confirm=reboot" "Restart")
      (button :class "menu-item" :onclick "eww -c ${EWW_CONFIG_DIR} update power-confirm=poweroff" "Power off"))
    (box :visible {power-confirm != ""} :orientation "v" :space-evenly false
      (label :class "confirm"
             :text "${power-confirm == 'lock' ? 'Lock' : power-confirm == 'logout' ? 'Log out' : power-confirm == 'reboot' ? 'Restart' : 'Power off'}: are you sure?")
      (box :space-evenly true :spacing 8
        (button :class "menu-item yes"
                :onclick "eww -c ${EWW_CONFIG_DIR} close power-${monitor} ; case '${power-confirm}' in lock) swaylock-configured ;; logout) floatilectl quit ;; reboot) systemctl reboot ;; poweroff) systemctl poweroff ;; esac"
          "Yes")
        (button :class "menu-item no"
                :onclick "eww -c ${EWW_CONFIG_DIR} update power-confirm='' ; eww -c ${EWW_CONFIG_DIR} close power-${monitor}"
          "No")))))
