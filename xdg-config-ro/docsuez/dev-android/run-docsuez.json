{
  "docker-run-script": {
    "0": [
      "DOCSUEZ_CONTAINER_BUILD_TIME_USER_NAME=wgh",
      "DOCSUEZ_CONTAINER_BUILD_TIME_UID=\"$(id -u)\""
    ]
  },
  "tags": {
    "network": {
      "docker-args": [
        "--network=host"
      ]
    },
    "homedir": {
      "volumes": {
        "$HOME/mk/misc/docker-home": "$DOCSUEZ_CONTAINER_HOME"
      },
      "docker-args": [
        "--workdir=$DOCSUEZ_CONTAINER_HOME"
      ]
    },
    "term": {
      "docker-run-script": [
        "DOCKER_RUN_EXTRAS+=(-e \"TERM=$TERM\")"
      ]
    },
    "ccache": {
      "docker-args": [
        "-e", "USE_CCACHE=1",
        "-e", "CCACHE_EXEC=/usr/bin/ccache",
        "-e", "CCACHE_DIR=$DOCSUEZ_CONTAINER_HOME/mk/ccache",
        "-e", "CCACHE_MAXSIZE=100G",
        "-e", "CCACHE_COMPRESS=1"
      ]
    },
    "mk": {
      "volumes": {
        "$HOME/mk/misc/mk-android": "$DOCSUEZ_CONTAINER_HOME/mk"
      }
    }
  }
}
