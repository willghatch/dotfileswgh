{
  "docker-run-script": {
    "0": [
      "DOCSUEZ_CONTAINER_BUILD_TIME_USER_NAME=wgh",
      "DOCSUEZ_CONTAINER_BUILD_TIME_UID=\"$(id -u)\""
    ]
  },
  "tags": {
    "homedir": {
      "volumes": {
        "$HOME/mk/misc/docker-home": "$DOCSUEZ_CONTAINER_HOME"
      },
      "docker-args": [
        "--workdir=$DOCSUEZ_CONTAINER_HOME"
      ]
    },
    "term": {
      "docker-run-script": [
        "DOCKER_RUN_EXTRAS+=(-e \"TERM=$TERM\")"
      ]
    },
    "mk": {
      "volumes": {
        "$HOME/mk/misc/mk-misc-default": "$DOCSUEZ_CONTAINER_HOME/mk"
      }
    }
  }
}
