{
  "docker-run-script": {
    "0": [
      "DOCSUEZ_CONTAINER_BUILD_TIME_USER_NAME=wgh",
      "DOCSUEZ_CONTAINER_BUILD_TIME_UID=\"$(id -u)\""
    ],
    "1": "DEV_TYPES=\"$DEV_TYPES,llvm,triton\""
  },
  "tags": {
    "homedir": {
      "volumes": {
        "$HOME/mk/amd/docker-home": "$DOCSUEZ_CONTAINER_HOME"
      },
      "docker-args": [
        "--workdir=$DOCSUEZ_CONTAINER_HOME"
      ]
    },
    "term": {
      "docker-run-script": [
        "DOCKER_RUN_EXTRAS+=(-e \"TERM=$TERM\")"
      ]
    },
    "ccache": {
      "docker-args": [
        "-e", "CCACHE_DIR=$DOCSUEZ_CONTAINER_HOME/mk/ccache", "-e", "TRITON_BUILD_WITH_CCACHE=true"
      ]
    },
    "mk": {
      "volumes": {
        "$HOME/mk/amd/mk-triton": "$DOCSUEZ_CONTAINER_HOME/mk"
      },
      "pre-tmux-script": [
        "source $DOTFILESWGH/env-more-with-mixins.sh",
        "cd mk",
        "cd triton",
        ""
      ]
    },
    "video-groups": {
      "docker-run-script": [
        "# Add video and render groups dynamically",
        "function groupid() { getent group \"$1\" | cut -d : -f 3; }",
        "DOCKER_RUN_EXTRAS+=(--group-add \"$(groupid render)\")",
        "DOCKER_RUN_EXTRAS+=(--group-add \"$(groupid video)\")"
      ],
      "docker-args": [
        "--cap-add=SYS_PTRACE",
        "--security-opt", "seccomp=unconfined",
        "--ipc=host",
        "--device=/dev/kfd",
        "--device=/dev/dri"
      ]

    }
  }
}
