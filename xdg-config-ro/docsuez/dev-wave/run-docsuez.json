{
  "docker-run-script": {
    "0": [
      "DOCSUEZ_CONTAINER_BUILD_TIME_USER_NAME=wgh",
      "DOCSUEZ_CONTAINER_BUILD_TIME_UID=\"$(id -u)\""
    ],
    "1": "DEV_TYPES=\"$DEV_TYPES,llvm,wave,gpu,amdgpu\""
  },
  "tags": {
    "network": {
      "docker-args": [
        "--network=host"
      ]
    },
    "homedir": {
      "volumes": {
        "$HOME/mk/amd/docker-home": "$DOCSUEZ_CONTAINER_HOME"
      },
      "docker-args": [
        "--workdir=$DOCSUEZ_CONTAINER_HOME"
      ]
    },
    "term": {
      "docker-run-script": [
        "DOCKER_RUN_EXTRAS+=(-e \"TERM=$TERM\")"
      ]
    },
    "mk": {
      "volumes": {
        "$HOME/mk/amd/mk-wave-default": "$DOCSUEZ_CONTAINER_HOME/mk"
      },
      "pre-tmux-script": {
        "50": [
          "cd mk",
          "cd wave",
          "# Don't source venv here, since it complicates worktree workflow",
          "#source .venv/bin/activate",
          ""
        ]
      }
    },
    "video-groups": {
      "docker-run-script": [
        "# Add video and render groups dynamically",
        "function groupid() { getent group \"$1\" | cut -d : -f 3; }",
        "DOCKER_RUN_EXTRAS+=(--group-add \"$(groupid render)\")",
        "DOCKER_RUN_EXTRAS+=(--group-add \"$(groupid video)\")"
      ],
      "docker-args": [
        "--cap-add=SYS_PTRACE",
        "--security-opt", "seccomp=unconfined",
        "--ipc=host",
        "--device=/dev/kfd",
        "--device=/dev/dri"
      ]

    }
  }
}
