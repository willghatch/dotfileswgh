{
    "docker-run-script": {
        "1": "DEV_TYPES=\"$DEV_TYPES,wave,iree\""
    },
    "tags": {
        "mk": {
            "volumes": {
                "$HOME/mk/amd/mk-wave-iree": "/home/wgh/mk"
            },
            "pre-tmux-script": [
                "source $DOTFILESWGH/env-more-with-mixins.sh",
                "cd mk",
                "source venv/bin/activate",
                "source iree-build/.env && export PYTHONPATH",
                "cd wave"
            ]
        }
    }
}
