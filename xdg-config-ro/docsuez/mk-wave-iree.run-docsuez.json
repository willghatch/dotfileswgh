{
    "docker-run-script": {
        "1": "DEV_TYPES=\"$DEV_TYPES,llvm,wave,iree,gpu,amdgpu\""
    },
    "tags": {
        "mk": {
            "volumes": {
                "$HOME/mk/amd/mk-wave-iree": "$DOCSUEZ_CONTAINER_HOME/mk"
            },
            "pre-tmux-script": [
                "source $DOTFILESWGH/env-more-with-mixins.sh",
                "cd mk",
                "source venv/bin/activate",
                "source iree-build/.env && export PYTHONPATH",
                "cd wave"
            ]
        }
    }
}
